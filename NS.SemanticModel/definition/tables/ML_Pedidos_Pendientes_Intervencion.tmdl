	column USO_DH_PREDICHO
		dataType: string
		lineageTag: 2861a958-96d8-4568-ab63-0684933c378b
		summarizeBy: none
		sourceColumn: USO_DH_PREDICHO

	partition ML_Pedidos_Pendientes_Intervencion = m
		mode: import
		source =
				let
				    CamposBase = {
				        "PED_NUMERO_PEDIDO", "PED_FECHA", "CLIENTE", "VENDEDOR", "PED_CANAL", "PED_REGION", "ZONA",
				        "VALOR_NETO", "ESTADO_ACTUAL", "HITO_ACTUAL", "RESPONSABLE_AREA", "DIAS_ACTUALES_DH",
				        "DIAS_EN_ESTADO_DH", "PROB_ML_ATRASO_NORM", "RIESGO_ML_ETIQUETA",
				        "HIST_CLIENTE_RIESGO", "HIST_VENDEDOR_RIESGO", "HIST_CANAL_RIESGO",
				        "RIESGO_HISTORICO_MAX", "HIST_SOPORTE_MIN", "SLA_CONSUMIDO_PCT",
				        "CRITERIOS_ACTIVOS", "FOCO_INTERVENCION", "PUNTOS_RIESGO_ML",
				        "PUNTOS_PERMANENCIA", "PUNTOS_VALOR", "PUNTOS_HISTORICO", "PUNTOS_FIN_MES",
				        "USO_DH_PREDICHO"
				    },
				    Base = Table.SelectColumns(ML_Pedidos_Pendientes_Priorizados, CamposBase, MissingField.UseNull),
				    ConExceso = Table.AddColumn(Base, "EXCESO_SLA_DH", each if [DIAS_ACTUALES_DH] - 5 > 0 then [DIAS_ACTUALES_DH] - 5 else 0, type number),
				    ConEstadoSLA = Table.AddColumn(ConExceso, "ESTADO_SLA_OPERATIVO", each
				        if [EXCESO_SLA_DH] > 0 then "FUERA SLA"
				        else if [DIAS_ACTUALES_DH] >= 4 then "PRÓXIMO A VENCER"
				        else "EN SLA", type text),
				    ConSeveridad = Table.AddColumn(ConEstadoSLA, "SEVERIDAD_SLA", each
				        if [EXCESO_SLA_DH] >= 10 then "VENCIDO EXTREMO"
				        else if [EXCESO_SLA_DH] >= 6 then "VENCIDO SEVERO"
				        else if [EXCESO_SLA_DH] >= 3 then "VENCIDO ALTO"
				        else if [EXCESO_SLA_DH] > 0 then "VENCIDO RECIENTE"
				        else if [DIAS_ACTUALES_DH] >= 4 then "PRÓXIMO SLA"
				        else "EN PLAZO", type text),
				    ConPuntosExceso = Table.AddColumn(ConSeveridad, "PUNTOS_EXCESO_SLA", each
				        if [EXCESO_SLA_DH] >= 10 then 40
				        else if [EXCESO_SLA_DH] >= 6 then 32
				        else if [EXCESO_SLA_DH] >= 3 then 25
				        else if [EXCESO_SLA_DH] > 0 then 18
				        else if [DIAS_ACTUALES_DH] >= 4 then 12
				        else if [DIAS_ACTUALES_DH] >= 3 then 8
				        else 0, Int64.Type),
				    ConScore = Table.AddColumn(ConPuntosExceso, "SCORE_INTERVENCION", each
				        let
				            total = [PUNTOS_EXCESO_SLA] + [PUNTOS_RIESGO_ML] + [PUNTOS_PERMANENCIA] +
				                [PUNTOS_VALOR] + [PUNTOS_HISTORICO] + [PUNTOS_FIN_MES]
				        in
				            Int64.From(if total > 100 then 100 else total), Int64.Type),
				    ConPrioridad = Table.AddColumn(ConScore, "PRIORIDAD_INTERVENCION", each
				        if [SCORE_INTERVENCION] >= 75 or [EXCESO_SLA_DH] >= 10 or [DIAS_EN_ESTADO_DH] >= 5 then "P1 · CRÍTICA"
				        else if [SCORE_INTERVENCION] >= 55 or [EXCESO_SLA_DH] >= 6 or [DIAS_EN_ESTADO_DH] >= 3 then "P2 · ALTA"
				        else if [SCORE_INTERVENCION] >= 35 or [EXCESO_SLA_DH] > 0 then "P3 · MEDIA"
				        else "P4 · BAJA", type text),
				    ConOrden = Table.AddColumn(ConPrioridad, "ORDEN_INTERVENCION", each
				        if [PRIORIDAD_INTERVENCION] = "P1 · CRÍTICA" then 1
				        else if [PRIORIDAD_INTERVENCION] = "P2 · ALTA" then 2
				        else if [PRIORIDAD_INTERVENCION] = "P3 · MEDIA" then 3
				        else 4, Int64.Type),
				    ConMotivo = Table.AddColumn(ConOrden, "MOTIVO_PRINCIPAL_INTERVENCION", each
				        if [EXCESO_SLA_DH] >= 10 then "Atraso extremo sobre SLA"
				        else if [DIAS_EN_ESTADO_DH] >= 5 then "Hito detenido por 5 DH o más"
				        else if [EXCESO_SLA_DH] >= 6 then "Atraso severo sobre SLA"
				        else if [PROB_ML_ATRASO_NORM] <> null and [PROB_ML_ATRASO_NORM] >= 0.20 then "Riesgo ML alto"
				        else if [VALOR_NETO] >= 5000000 then "Alta exposición económica"
				        else if [RIESGO_HISTORICO_MAX] >= 0.20 and [HIST_SOPORTE_MIN] > 0 then "Patrón histórico alto"
				        else if [EXCESO_SLA_DH] > 0 then "SLA vencido reciente"
				        else if [DIAS_EN_ESTADO_DH] >= 2 then "Permanencia en hito"
				        else "Seguimiento preventivo", type text),
				    ConEstadoAccion = Table.AddColumn(ConMotivo, "ESTADO_ACCION_V2", each
				        if [PRIORIDAD_INTERVENCION] = "P1 · CRÍTICA" then "INTERVENIR HOY"
				        else if [PRIORIDAD_INTERVENCION] = "P2 · ALTA" then "REVISAR HOY"
				        else if [PRIORIDAD_INTERVENCION] = "P3 · MEDIA" then "PLAN 24 HORAS"
				        else "MONITOREAR", type text),
				    ConAccion = Table.AddColumn(ConEstadoAccion, "ACCION_INTERVENCION", each
				        let foco = if [FOCO_INTERVENCION] = null or Text.Trim([FOCO_INTERVENCION]) = "" then "área responsable" else [FOCO_INTERVENCION]
				        in
				            if [PRIORIDAD_INTERVENCION] = "P1 · CRÍTICA" then "Escalar hoy a " & foco & "; confirmar causa, responsable y hora de liberación"
				            else if [PRIORIDAD_INTERVENCION] = "P2 · ALTA" then "Revisar hoy con " & foco & "; fijar compromiso y próxima actualización"
				            else if [PRIORIDAD_INTERVENCION] = "P3 · MEDIA" then "Definir plan de salida en 24 horas con " & foco
				            else "Monitorear avance y mantener responsable visible", type text),
				    Ordenado = Table.Sort(ConAccion, {
				        {"ORDEN_INTERVENCION", Order.Ascending},
				        {"SCORE_INTERVENCION", Order.Descending},
				        {"EXCESO_SLA_DH", Order.Descending},
				        {"DIAS_EN_ESTADO_DH", Order.Descending},
				        {"VALOR_NETO", Order.Descending},
				        {"PED_NUMERO_PEDIDO", Order.Ascending}
				    }),
				    ConRank = Table.AddIndexColumn(Ordenado, "RANK_INTERVENCION", 1, 1, Int64.Type),
				    ConTramo = Table.AddColumn(ConRank, "TRAMO_RANKING", each
				        if [RANK_INTERVENCION] <= 5 then "TOP 5"
				        else if [RANK_INTERVENCION] <= 10 then "TOP 10"
				        else "RESTO", type text),
				    Seleccion = Table.SelectColumns(ConTramo, {
				        "RANK_INTERVENCION", "TRAMO_RANKING", "PRIORIDAD_INTERVENCION", "ORDEN_INTERVENCION",
				        "ESTADO_ACCION_V2", "ESTADO_SLA_OPERATIVO", "SEVERIDAD_SLA", "EXCESO_SLA_DH",
				        "SCORE_INTERVENCION", "PUNTOS_EXCESO_SLA", "MOTIVO_PRINCIPAL_INTERVENCION",
				        "ACCION_INTERVENCION", "PED_NUMERO_PEDIDO", "PED_FECHA", "CLIENTE", "VENDEDOR",
				        "PED_CANAL", "PED_REGION", "ZONA", "VALOR_NETO", "ESTADO_ACTUAL", "HITO_ACTUAL",
				        "RESPONSABLE_AREA", "DIAS_ACTUALES_DH", "DIAS_EN_ESTADO_DH", "PROB_ML_ATRASO_NORM",
				        "RIESGO_ML_ETIQUETA", "HIST_CLIENTE_RIESGO", "HIST_VENDEDOR_RIESGO",
				        "HIST_CANAL_RIESGO", "RIESGO_HISTORICO_MAX", "HIST_SOPORTE_MIN",
				        "SLA_CONSUMIDO_PCT", "CRITERIOS_ACTIVOS", "FOCO_INTERVENCION", "PUNTOS_RIESGO_ML",
				        "PUNTOS_PERMANENCIA", "PUNTOS_VALOR", "PUNTOS_HISTORICO", "PUNTOS_FIN_MES",
				        "USO_DH_PREDICHO"
				    }),
				    Tipos = Table.TransformColumnTypes(Seleccion, {
				        {"RANK_INTERVENCION", Int64.Type}, {"TRAMO_RANKING", type text},
				        {"PRIORIDAD_INTERVENCION", type text}, {"ORDEN_INTERVENCION", Int64.Type},
				        {"ESTADO_ACCION_V2", type text}, {"ESTADO_SLA_OPERATIVO", type text},
				        {"SEVERIDAD_SLA", type text}, {"EXCESO_SLA_DH", type number},
				        {"SCORE_INTERVENCION", Int64.Type}, {"PUNTOS_EXCESO_SLA", Int64.Type},
				        {"MOTIVO_PRINCIPAL_INTERVENCION", type text}, {"ACCION_INTERVENCION", type text}
				    })
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

