/// Cola de intervención V2. Separa estado SLA de prioridad relativa para discriminar pedidos vencidos.
table ML_Pedidos_Pendientes_Intervencion
	lineageTag: dc25a984-0ce0-428e-bb3c-e150d55730da

	measure 'Pendientes P1 Crítica' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[PRIORIDAD_INTERVENCION] = "P1 · CRÍTICA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\Prioridad
		lineageTag: 125143b3-49ee-450c-ad6e-489c4a08cf44

	measure 'Pendientes P2 Alta' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[PRIORIDAD_INTERVENCION] = "P2 · ALTA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\Prioridad
		lineageTag: 174843e0-8e58-4c74-b3bb-67ab1b69aa0a

	measure 'Pendientes P3 Media' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[PRIORIDAD_INTERVENCION] = "P3 · MEDIA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\Prioridad
		lineageTag: c712d6a5-77b0-42cc-9726-6552d2130bcf

	measure 'Pendientes P4 Baja' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[PRIORIDAD_INTERVENCION] = "P4 · BAJA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\Prioridad
		lineageTag: d3d8644a-f9d6-49b3-b2af-54baf4d39753

	measure 'Valor P1 y P2' = CALCULATE(SUM(ML_Pedidos_Pendientes_Intervencion[VALOR_NETO]), ML_Pedidos_Pendientes_Intervencion[PRIORIDAD_INTERVENCION] IN {"P1 · CRÍTICA", "P2 · ALTA"})
		formatString: "CLP $" #,0;-"CLP $" #,0;"CLP $" 0
		displayFolder: 05. Pedidos Pendientes V2\Impacto
		lineageTag: f787ef29-7b60-42c5-95b5-5c30f8a26b15

	measure 'Exceso SLA Promedio' = AVERAGE(ML_Pedidos_Pendientes_Intervencion[EXCESO_SLA_DH])
		formatString: 0.0
		displayFolder: 05. Pedidos Pendientes V2\SLA
		lineageTag: e611ce85-fe06-4546-a667-9a8b4da4b5bf

	measure 'Exceso SLA Máximo' = MAX(ML_Pedidos_Pendientes_Intervencion[EXCESO_SLA_DH])
		formatString: 0.0
		displayFolder: 05. Pedidos Pendientes V2\SLA
		lineageTag: 67dce2d6-d771-4f0a-8fa7-abf8b9047888

	measure 'Pendientes Top 10' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[TRAMO_RANKING] = "TOP 10")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\Ranking
		lineageTag: 80ea6858-13ed-4f17-a538-2b0b7713daee

	measure 'Pendientes Vencido Severo' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Intervencion), ML_Pedidos_Pendientes_Intervencion[SEVERIDAD_SLA] IN {"VENCIDO EXTREMO", "VENCIDO SEVERO"})
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes V2\SLA
		lineageTag: 1d77789e-16c7-4c24-aea0-dd33c6b63b1f

	column RANK_INTERVENCION
