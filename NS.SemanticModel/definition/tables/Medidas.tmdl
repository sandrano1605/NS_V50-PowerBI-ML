	measure 'RE TT Cierre' = IF(NOT ISBLANK([RE TT Días Top 10]), MAX(Fact_Tracking[FECHA_CIERRE]))
		formatString: dd-MM-yyyy HH:mm
		displayFolder: 02. Resumen Ejecutivo\09. Tooltip
		lineageTag: 27000000-0000-4000-8000-000000000135

	measure 'RE TT Título' =
			VAR Flujo = SELECTEDVALUE(Dim_Vista_Ejecutiva[Flujo])
			VAR Zona = SELECTEDVALUE(Dim_Rango_Entrega[Zona])
			VAR Rango = SELECTEDVALUE(Dim_Rango_Entrega[Rango])
			VAR Contexto = COALESCE(Flujo, IF(NOT ISBLANK(Zona), Zona & IF(NOT ISBLANK(Rango), " · " & Rango, ""), "Universo cerrado") )
			VAR FlujoSel = SELECTEDVALUE(Dim_Vista_Ejecutiva[Flujo])
			VAR ZonaSel = SELECTEDVALUE(Dim_Rango_Entrega[Zona])
			VAR MinDH = SELECTEDVALUE(Dim_Rango_Entrega[MinDH])
			VAR MaxDH = SELECTEDVALUE(Dim_Rango_Entrega[MaxDH])
			VAR TieneRango = HASONEVALUE(Dim_Rango_Entrega[Rango])
			VAR Cohorte =
				FILTER(
					Fact_Tracking,
					Fact_Tracking[ES_CERRADO] = TRUE()
						&& NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
						&& (
							ISBLANK(FlujoSel)
								|| (CONTAINSSTRING(FlujoSel, "Flujo Normal") && Fact_Tracking[CLASIFICACION] = "NORMAL")
								|| (CONTAINSSTRING(FlujoSel, "FES") && Fact_Tracking[CLASIFICACION] IN {"FES", "FES + SALDO"})
								|| (CONTAINSSTRING(FlujoSel, "Saldos") && Fact_Tracking[CLASIFICACION] = "SALDO")
						)
						&& (ISBLANK(ZonaSel) || Fact_Tracking[ZONA] = ZonaSel)
						&& (NOT TieneRango || (Fact_Tracking[DIAS_INTERNOS_DH] >= MinDH && (ISBLANK(MaxDH) || Fact_Tracking[DIAS_INTERNOS_DH] <= MaxDH)))
				)
			VAR MinCre = MINX(Cohorte, Fact_Tracking[PED_FECHA_HORA])
			VAR MaxCre = MAXX(Cohorte, Fact_Tracking[PED_FECHA_HORA])
			VAR PedidosContexto = [RE Pedidos contexto]
			VAR FilasMostradas = MIN(10, PedidosContexto)
			RETURN
				"TOP CRÍTICOS · "
				& FORMAT(FilasMostradas, "#,##0", "es-CL") & " de " & FORMAT(PedidosContexto, "#,##0", "es-CL") & " pedidos"
				& " · " & COALESCE(FORMAT(MinCre, "dd-MM-yyyy"), "--") & " a " & COALESCE(FORMAT(MaxCre, "dd-MM-yyyy"), "--")
				& " · " & Contexto
		displayFolder: 02. Resumen Ejecutivo\09. Tooltip
		lineageTag: 27000000-0000-4000-8000-000000000136

	measure 'RE Subtítulo gráfico' = [RE Periodo contexto] & "  ·  Columnas: pedidos cohorte  ·  Líneas: NS interno y participación"
		displayFolder: 02. Resumen Ejecutivo\07. Texto
		lineageTag: 27000000-0000-4000-8000-000000000137

	measure 'RE Subtítulo promesa' = "*Incluye +2 DH estimados de tránsito  ·  sin POD/última milla"
		displayFolder: 02. Resumen Ejecutivo\07. Texto
		lineageTag: 27000000-0000-4000-8000-000000000138

	measure 'RE TT Hito crítico' =
			VAR Pedido = SELECTEDVALUE(Fact_Tracking[PED_NUMERO_PEDIDO])
			VAR Base =
				CALCULATETABLE(
					ADDCOLUMNS(
						SUMMARIZE(
							Fact_Hitos_Operacionales,
							Fact_Hitos_Operacionales[METRICA_CODIGO],
							Fact_Hitos_Operacionales[HITO],
							Fact_Hitos_Operacionales[ORDEN_HITO]
						),
						"@Exceso", CALCULATE(MAX(Fact_Hitos_Operacionales[EXCESO_DH])),
						"@Dias", CALCULATE(MAX(Fact_Hitos_Operacionales[DIAS_HABILES]))
					),
					REMOVEFILTERS(Config_SLA_Hitos),
					REMOVEFILTERS(Fact_Hitos_Operacionales[METRICA_CODIGO]),
					REMOVEFILTERS(Fact_Hitos_Operacionales[HITO]),
					TREATAS({Pedido}, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO]),
					Fact_Hitos_Operacionales[ACTIVO_CUELLO] = TRUE(),
					NOT (Fact_Hitos_Operacionales[TIPO_KPI] IN {"KPI MACRO", "DIAGNÓSTICO INTEGRAL", "DIAGNÓSTICO FES"})
				)
			VAR Fila = TOPN(1, FILTER(Base, NOT ISBLANK([@Dias])), [@Exceso], DESC, [@Dias], DESC, Fact_Hitos_Operacionales[ORDEN_HITO], ASC)
			RETURN IF(NOT ISBLANK([RE TT Días Top 10]), COALESCE(MAXX(Fila, Fact_Hitos_Operacionales[HITO]), "Sin hito evaluable"))
		displayFolder: 02. Resumen Ejecutivo\09. Tooltip
		lineageTag: 34000000-0000-4000-8000-000000000101

	measure 'RE TT Exceso crítico DH' =
			VAR Pedido = SELECTEDVALUE(Fact_Tracking[PED_NUMERO_PEDIDO])
			VAR Base =
				CALCULATETABLE(
					ADDCOLUMNS(
						SUMMARIZE(Fact_Hitos_Operacionales, Fact_Hitos_Operacionales[METRICA_CODIGO], Fact_Hitos_Operacionales[ORDEN_HITO]),
						"@Exceso", CALCULATE(MAX(Fact_Hitos_Operacionales[EXCESO_DH])),
						"@Dias", CALCULATE(MAX(Fact_Hitos_Operacionales[DIAS_HABILES]))
					),
					REMOVEFILTERS(Config_SLA_Hitos),
					REMOVEFILTERS(Fact_Hitos_Operacionales[METRICA_CODIGO]),
					REMOVEFILTERS(Fact_Hitos_Operacionales[HITO]),
					TREATAS({Pedido}, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO]),
					Fact_Hitos_Operacionales[ACTIVO_CUELLO] = TRUE(),
					NOT (Fact_Hitos_Operacionales[TIPO_KPI] IN {"KPI MACRO", "DIAGNÓSTICO INTEGRAL", "DIAGNÓSTICO FES"})
				)
			VAR Fila = TOPN(1, FILTER(Base, NOT ISBLANK([@Dias])), [@Exceso], DESC, [@Dias], DESC, Fact_Hitos_Operacionales[ORDEN_HITO], ASC)
			RETURN IF(NOT ISBLANK([RE TT Días Top 10]), MAX(0, COALESCE(MAXX(Fila, [@Exceso]), 0)))
		formatString: 0 "DH"
		displayFolder: 02. Resumen Ejecutivo\09. Tooltip
		lineageTag: 34000000-0000-4000-8000-000000000102

	/// Motivo operativo asociado al hito dominante. No reemplaza una causa raíz registrada por el área responsable.
	measure 'RE TT Motivo operativo' =
			VAR Pedido = SELECTEDVALUE(Fact_Tracking[PED_NUMERO_PEDIDO])
			VAR Base =
				CALCULATETABLE(
					ADDCOLUMNS(
						SUMMARIZE(
							Fact_Hitos_Operacionales,
							Fact_Hitos_Operacionales[METRICA_CODIGO],
							Fact_Hitos_Operacionales[ORDEN_HITO],
							Fact_Hitos_Operacionales[ESTADO_TRAZABILIDAD]
						),
						"@Exceso", CALCULATE(MAX(Fact_Hitos_Operacionales[EXCESO_DH])),
						"@Dias", CALCULATE(MAX(Fact_Hitos_Operacionales[DIAS_HABILES]))
					),
					REMOVEFILTERS(Config_SLA_Hitos),
					REMOVEFILTERS(Fact_Hitos_Operacionales[METRICA_CODIGO]),
					REMOVEFILTERS(Fact_Hitos_Operacionales[HITO]),
					TREATAS({Pedido}, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO]),
					Fact_Hitos_Operacionales[ACTIVO_CUELLO] = TRUE(),
					NOT (Fact_Hitos_Operacionales[TIPO_KPI] IN {"KPI MACRO", "DIAGNÓSTICO INTEGRAL", "DIAGNÓSTICO FES"})
				)
			VAR Fila = TOPN(1, FILTER(Base, NOT ISBLANK([@Dias])), [@Exceso], DESC, [@Dias], DESC, Fact_Hitos_Operacionales[ORDEN_HITO], ASC)
			VAR Codigo = MAXX(Fila, Fact_Hitos_Operacionales[METRICA_CODIGO])
			VAR Trazabilidad = MAXX(Fila, Fact_Hitos_Operacionales[ESTADO_TRAZABILIDAD])
			RETURN
				IF(
					ISBLANK([RE TT Días Top 10]),
					BLANK(),
					SWITCH(
						TRUE(),
						Trazabilidad = "SECUENCIA INVÁLIDA", "Revisar secuencia de fechas",
						CONTAINSSTRING(COALESCE(Trazabilidad, ""), "OMIT"), "Hito omitido o trazabilidad incompleta",
						Codigo = "PDA_CREACION", "Espera de creación/digitación del pedido",
						Codigo = "CREACION_COMERCIAL", "Espera de liberación Comercial/SAC",
						Codigo = "COMERCIAL_CREDITO", "Espera de revisión o liberación de crédito",
						Codigo = "CREDITO_ENTREGA", "Liberado sin ingreso oportuno a Logística",
						Codigo = "ENTREGA_FACTURACION", "Espera interna hasta facturación",
						Codigo IN {"FACTURACION_DESPACHO", "OPERACIONES_TOTAL"}, "Factura sin salida o espera de transporte",
						LEFT(COALESCE(Codigo, ""), 4) = "FES_", "Espera de pedido posterior, entrega o manifiesto FES",
						Codigo = "ADMIN_TOTAL", "Demora acumulada del bloque administrativo",
						Codigo = "MAYORISTA_CIERRE_TOTAL", "Demora integral; revisar el subproceso dominante",
						"Motivo no registrado; revisar detalle 360"
					)
				)
		displayFolder: 02. Resumen Ejecutivo\09. Tooltip
		lineageTag: 34000000-0000-4000-8000-000000000103

	measure 'RE Tarjeta pedidos' = FORMAT([RE Pedidos contexto], "#,##0", "es-CL")
		displayFolder: 02. Resumen Ejecutivo\07. Tarjetas
		lineageTag: 36000000-0000-4000-8000-000000000101

	measure 'RE Tarjeta valor' = "CLP " & FORMAT(DIVIDE([RE Valor contexto], 1000000), "#,##0.0", "es-CL") & " MM"
		displayFolder: 02. Resumen Ejecutivo\07. Tarjetas
		lineageTag: 36000000-0000-4000-8000-000000000102

	measure 'RE Tarjeta NS' = FORMAT([RE NS contexto], "0.0%", "es-CL")
		displayFolder: 02. Resumen Ejecutivo\07. Tarjetas
		lineageTag: 36000000-0000-4000-8000-000000000103

	/// Cantidad cerrada y evaluable del mes mostrado en el gráfico comparativo de tres meses.
	measure 'M3 Pedidos evaluados' =
			VAR Mes = SELECTEDVALUE(Dim_Mes_Trend[AnioMes])
			RETURN
				CALCULATE(
					DISTINCTCOUNT(Fact_Tracking[PED_NUMERO_PEDIDO]),
					REMOVEFILTERS(Dim_Periodo_3M),
					REMOVEFILTERS(Dim_Fecha),
					TREATAS({Mes}, Dim_Fecha[AnioMes]),
					Fact_Tracking[ES_CERRADO] = TRUE(),
					NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
				)
		formatString: #,##0
		displayFolder: 02. Resumen Ejecutivo\08. Comparación mensual
		lineageTag: 39000000-0000-4000-8000-000000000101

	measure 'M3 Promedio total DH' =
			VAR Mes = SELECTEDVALUE(Dim_Mes_Trend[AnioMes])
			RETURN
				CALCULATE(
					AVERAGE(Fact_Tracking[DIAS_INTERNOS_DH]),
					REMOVEFILTERS(Dim_Periodo_3M),
					REMOVEFILTERS(Dim_Fecha),
					TREATAS({Mes}, Dim_Fecha[AnioMes]),
					Fact_Tracking[ES_CERRADO] = TRUE(),
					NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
				)
		formatString: 0.0 "DH"
		displayFolder: 02. Resumen Ejecutivo\08. Comparación mensual
		lineageTag: 39000000-0000-4000-8000-000000000102

	measure 'M3 Promedio administrativo DH' =
			VAR Mes = SELECTEDVALUE(Dim_Mes_Trend[AnioMes])
			VAR PedidosMes =
				SELECTCOLUMNS(
					CALCULATETABLE(
						VALUES(Fact_Tracking[PED_NUMERO_PEDIDO]),
						REMOVEFILTERS(Dim_Periodo_3M),
						REMOVEFILTERS(Dim_Fecha),
						TREATAS({Mes}, Dim_Fecha[AnioMes]),
						Fact_Tracking[ES_CERRADO] = TRUE(),
						NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
					),
					"Pedido", Fact_Tracking[PED_NUMERO_PEDIDO]
				)
			RETURN
				AVERAGEX(
					PedidosMes,
					VAR PedidoActual = [Pedido]
					RETURN
						COALESCE(
							CALCULATE(
								MAX(Fact_Hitos_Operacionales[DIAS_HABILES]),
								REMOVEFILTERS(Dim_Periodo_3M),
								REMOVEFILTERS(Dim_Fecha),
								TREATAS({PedidoActual}, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO]),
								Fact_Hitos_Operacionales[METRICA_CODIGO] = "ADMIN_TOTAL"
							),
							0
						)
				)
		formatString: 0.0 "DH"
		displayFolder: 02. Resumen Ejecutivo\08. Comparación mensual
		lineageTag: 39000000-0000-4000-8000-000000000103

	measure 'M3 Promedio operaciones DH' =
			VAR Mes = SELECTEDVALUE(Dim_Mes_Trend[AnioMes])
			VAR PedidosMes =
				SELECTCOLUMNS(
					CALCULATETABLE(
						VALUES(Fact_Tracking[PED_NUMERO_PEDIDO]),
						REMOVEFILTERS(Dim_Periodo_3M),
						REMOVEFILTERS(Dim_Fecha),
						TREATAS({Mes}, Dim_Fecha[AnioMes]),
						Fact_Tracking[ES_CERRADO] = TRUE(),
						NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
					),
					"Pedido", Fact_Tracking[PED_NUMERO_PEDIDO]
				)
			RETURN
				AVERAGEX(
					PedidosMes,
					VAR PedidoActual = [Pedido]
					RETURN
						COALESCE(
							CALCULATE(
								MAX(Fact_Hitos_Operacionales[DIAS_HABILES]),
								REMOVEFILTERS(Dim_Periodo_3M),
								REMOVEFILTERS(Dim_Fecha),
								TREATAS({PedidoActual}, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO]),
								Fact_Hitos_Operacionales[METRICA_CODIGO] = "OPERACIONES_TOTAL"
							),
							0
						)
				)
		formatString: 0.0 "DH"
		displayFolder: 02. Resumen Ejecutivo\08. Comparación mensual
		lineageTag: 39000000-0000-4000-8000-000000000104

	measure 'M3 NS interno %' =
			VAR Mes = SELECTEDVALUE(Dim_Mes_Trend[AnioMes])
			VAR Total =
				CALCULATE(
					DISTINCTCOUNT(Fact_Tracking[PED_NUMERO_PEDIDO]),
					REMOVEFILTERS(Dim_Periodo_3M),
					REMOVEFILTERS(Dim_Fecha),
					TREATAS({Mes}, Dim_Fecha[AnioMes]),
					Fact_Tracking[ES_CERRADO] = TRUE(),
					NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
				)
			VAR Cumple =
				CALCULATE(
					DISTINCTCOUNT(Fact_Tracking[PED_NUMERO_PEDIDO]),
					REMOVEFILTERS(Dim_Periodo_3M),
					REMOVEFILTERS(Dim_Fecha),
					TREATAS({Mes}, Dim_Fecha[AnioMes]),
					Fact_Tracking[ES_CERRADO] = TRUE(),
					NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH]),
					Fact_Tracking[CUMPLE_SLA_INTERNO] = TRUE()
				)
			RETURN DIVIDE(Cumple, Total)
		formatString: 0.0%
		displayFolder: 02. Resumen Ejecutivo\08. Comparación mensual
		lineageTag: 39000000-0000-4000-8000-000000000105

	measure 'M3 Subtítulo' =
