	measure 'RE Color NS' = SWITCH(TRUE(), ISBLANK([RE NS contexto]), "#84807D", [RE NS contexto] >= 0.9, "#2E8B57", [RE NS contexto] >= 0.8, "#D5A000", "#D3392C")
		displayFolder: 02. Resumen Ejecutivo\07. Texto
