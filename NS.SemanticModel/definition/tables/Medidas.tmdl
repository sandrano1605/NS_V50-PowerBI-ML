	measure 'FA Lectura Carga SLA' = VAR Momento = SELECTEDVALUE(Dim_Fecha[Momento_Mes]) VAR Carga = [FA Carga % del Mes] VAR PorcFES = [FA Carga % FES] VAR DeltaNS = [FA Delta NS vs Resto] RETURN SWITCH(TRUE(), ISBLANK([FA Carga Pedidos Creados]), BLANK(), Momento = "Resto del mes", "BASE DE COMPARACIÓN", Momento = "Cierre · últimos 7 DH" && DeltaNS <= -0.10 && PorcFES >= 0.35 && Carga >= 0.35, "FES + ALTA CARGA COINCIDEN CON CAÍDA", DeltaNS <= -0.10 && Carga >= 0.35, "ALTA CARGA COINCIDE CON CAÍDA", Momento = "Inicio · primeros 7 DH" && DeltaNS <= -0.08, "ARRASTRE VISIBLE AL INICIO", PorcFES >= 0.35 && DeltaNS > -0.05, "FES ALTA SIN CAÍDA RELEVANTE", "SIN DETERIORO RELEVANTE")
		displayFolder: 04. Análisis Fuera SLA\Carga y SLA
		lineageTag: 58000000-0000-4000-8000-000000000211

