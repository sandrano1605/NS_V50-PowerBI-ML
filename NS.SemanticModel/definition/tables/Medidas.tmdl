	/// Meses distintos con al menos un pedido fuera SLA para el cliente en el contexto de los últimos 3 meses. Ignora el filtro de mes del canvas.
	/// Cuenta únicamente los meses válidos de la ventana 3M; excluye la fila en blanco de la relación calendario-periodo.
	measure 'FA Meses Fuera SLA Cliente' =
			VAR MesesVentana =
				FILTER(
					ALL(Dim_Periodo_3M[AnioMes]),
					NOT ISBLANK(Dim_Periodo_3M[AnioMes])
				)
			RETURN
				SUMX(
					MesesVentana,
					VAR MesEvaluado = Dim_Periodo_3M[AnioMes]
					VAR PedidosFueraMes =
						CALCULATE(
							[RE Pedidos fuera SLA contexto],
							REMOVEFILTERS(Dim_Fecha),
							TREATAS({MesEvaluado}, Dim_Fecha[AnioMes])
						)
					RETURN IF(PedidosFueraMes > 0, 1, 0)
				)
		formatString: #,0
		displayFolder: 04. Análisis Fuera SLA\Recurrencia 3M
		lineageTag: 56000000-0000-4000-8000-000000000001

	measure 'FA Recurrencia Cliente' = SWITCH(TRUE(), [FA Meses Fuera SLA Cliente] >= 3, "Recurrente 3M", [FA Meses Fuera SLA Cliente] = 2, "Recurrente 2M", [FA Meses Fuera SLA Cliente] = 1, "Puntual 1M", "Sin incumplimiento")
		displayFolder: 04. Análisis Fuera SLA\Recurrencia 3M
		lineageTag: 56000000-0000-4000-8000-000000000002

	measure 'FA Clientes Recurrentes 2M+' = COUNTROWS(FILTER(VALUES(Dim_Cliente[CLIENTE_CODIGO]), CALCULATE([FA Meses Fuera SLA Cliente]) >= 2))
		formatString: #,0
		displayFolder: 04. Análisis Fuera SLA\Recurrencia 3M
		lineageTag: 56000000-0000-4000-8000-000000000003

