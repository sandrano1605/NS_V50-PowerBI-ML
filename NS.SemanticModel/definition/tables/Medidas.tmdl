	measure 'RE Tooltip seleccionado texto' =
			VAR FlujoSel = SELECTEDVALUE(Dim_Vista_Ejecutiva[Flujo])
			VAR ZonaSel = SELECTEDVALUE(Dim_Rango_Entrega[Zona])
			VAR Base = FILTER(ALLSELECTED(Fact_Tracking), Fact_Tracking[ES_CERRADO] = TRUE() && NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH]) && (ISBLANK(FlujoSel) || (CONTAINSSTRING(FlujoSel,"Flujo Normal") && Fact_Tracking[CLASIFICACION]="NORMAL") || (CONTAINSSTRING(FlujoSel,"FES") && Fact_Tracking[CLASIFICACION] IN {"FES","FES + SALDO"}) || (CONTAINSSTRING(FlujoSel,"Saldos") && Fact_Tracking[CLASIFICACION]="SALDO")) && (ISBLANK(ZonaSel) || Fact_Tracking[ZONA]=ZonaSel))
			VAR PedidoSeleccionado = SELECTEDVALUE(Fact_Tracking[PED_NUMERO_PEDIDO])
			VAR PedidoTop = MAXX(TOPN(1, Base, Fact_Tracking[DIAS_INTERNOS_DH], DESC, Fact_Tracking[PED_NUMERO_PEDIDO], ASC), Fact_Tracking[PED_NUMERO_PEDIDO])
			VAR Pedido = COALESCE(PedidoSeleccionado, PedidoTop)
			VAR Codigo = CALCULATE(MAX(Fact_Tracking[PED_CODIGO_CLIENTE]), TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			VAR Cliente = COALESCE(LOOKUPVALUE(Dim_Cliente[CLIENTE_NOMBRE], Dim_Cliente[CLIENTE_CODIGO], Codigo), Codigo, "Sin cliente")
			VAR Vendedor = COALESCE(LOOKUPVALUE(Dim_Cliente[VENDEDOR_NOMBRE], Dim_Cliente[CLIENTE_CODIGO], Codigo), CALCULATE(MAX(Fact_Tracking[PED_RESPONSABLE]), TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO])), "Sin vendedor")
			VAR Dias = CALCULATE(MAX(Fact_Tracking[DIAS_INTERNOS_DH]), TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			VAR Hito = CALCULATE([RE TT Hito crítico], TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			VAR Exceso = CALCULATE([RE TT Exceso crítico DH], TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			VAR Motivo = CALCULATE([RE TT Motivo operativo], TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			VAR Cierre = CALCULATE(MAX(Fact_Tracking[FECHA_CIERRE]), TREATAS({Pedido}, Fact_Tracking[PED_NUMERO_PEDIDO]))
			RETURN
			"¿POR QUÉ ESTE PEDIDO ESTÁ FUERA DE SLA?" & UNICHAR(10)
			& "Pedido: " & COALESCE(FORMAT(Pedido,"0"),"--") & UNICHAR(10)
			& "Cliente: " & Cliente & UNICHAR(10)
			& "Vendedor: " & Vendedor & UNICHAR(10)
			& "DH total: " & COALESCE(FORMAT(Dias,"0"),"--") & " · Exceso: " & COALESCE(FORMAT(Exceso,"0"),"--") & " DH" & UNICHAR(10)
			& "Hito dominante: " & COALESCE(Hito,"Sin dato") & UNICHAR(10)
			& "Motivo asociado: " & COALESCE(Motivo,"Sin evidencia suficiente") & UNICHAR(10)
			& "Cierre operativo: " & COALESCE(FORMAT(Cierre,"dd-MM-yyyy HH:mm"),"--")
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 04d04d34-1e2e-43b1-b66a-13de29a711a5

	/// Cohorte ejecutiva superior: conserva filtros de negocio, pero siempre resume la ventana completa de tres meses.
	measure 'RE Pedidos 3M contexto' =
			CALCULATE(
				[RE Pedidos contexto],
				REMOVEFILTERS(Dim_Periodo_3M),
				REMOVEFILTERS(Dim_Fecha)
			)
		formatString: #,##0
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 44000000-0000-4000-8000-000000000101

	measure 'RE Pedidos en SLA 3M contexto' =
			CALCULATE(
				[RE Pedidos en SLA contexto],
				REMOVEFILTERS(Dim_Periodo_3M),
				REMOVEFILTERS(Dim_Fecha)
			)
		formatString: #,##0
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 44000000-0000-4000-8000-000000000102

	measure 'RE Pedidos fuera SLA 3M contexto' = [RE Pedidos 3M contexto] - [RE Pedidos en SLA 3M contexto]
		formatString: #,##0
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 44000000-0000-4000-8000-000000000103

	measure 'RE NS 3M contexto' = DIVIDE([RE Pedidos en SLA 3M contexto], [RE Pedidos 3M contexto])
		formatString: 0.0%
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 44000000-0000-4000-8000-000000000104

	measure 'RE Valor 3M contexto' =
			CALCULATE(
				[RE Valor contexto],
				REMOVEFILTERS(Dim_Periodo_3M),
				REMOVEFILTERS(Dim_Fecha)
			)
		formatString: #,##0
