	measure 'RE Valor en SLA 3M contexto' =
			CALCULATE(
				[RE Valor en SLA contexto],
				REMOVEFILTERS(Dim_Periodo_3M),
				REMOVEFILTERS(Dim_Fecha)
			)
		formatString: #,##0
		displayFolder: 02. Resumen Ejecutivo\10. Diseño 2026
		lineageTag: 44000000-0000-4000-8000-000000000106

	measure 'RE Valor fuera SLA 3M contexto' = [RE Valor 3M contexto] - [RE Valor en SLA 3M contexto]
		formatString: #,##0
