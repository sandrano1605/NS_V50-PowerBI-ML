	measure 'RE Subtítulo valor' =
			"En SLA CLP " & FORMAT(DIVIDE([RE Valor en SLA contexto], 1000000), "#,##0.0", "es-CL") & " MM"
			& "  ·  Fuera CLP " & FORMAT(DIVIDE([RE Valor fuera SLA contexto], 1000000), "#,##0.0", "es-CL") & " MM"
		displayFolder: 02. Resumen Ejecutivo\07. Texto
