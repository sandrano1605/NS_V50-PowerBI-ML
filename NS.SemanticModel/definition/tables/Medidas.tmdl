	measure 'RE P90 hito DH' =
			VAR Codigo = [RE Código nivel matriz]
			VAR EsNivelIntegral = NOT ISINSCOPE(Dim_Vista_Ejecutiva[Macroproceso])
			VAR FlujoSel = SELECTEDVALUE(Dim_Vista_Ejecutiva[Flujo])
			VAR ZonaSel = SELECTEDVALUE(Dim_Rango_Entrega[Zona])
			VAR MinDH = SELECTEDVALUE(Dim_Rango_Entrega[MinDH])
			VAR MaxDH = SELECTEDVALUE(Dim_Rango_Entrega[MaxDH])
			VAR TieneRango = HASONEVALUE(Dim_Rango_Entrega[Rango])
			VAR PedidosCohorte =
				CALCULATETABLE(
					VALUES(Fact_Tracking[PED_NUMERO_PEDIDO]),
					KEEPFILTERS(
						FILTER(
							Fact_Tracking,
							Fact_Tracking[ES_CERRADO] = TRUE()
								&& NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
								&& (
									ISBLANK(FlujoSel)
										|| (CONTAINSSTRING(FlujoSel, "Flujo Normal") && Fact_Tracking[CLASIFICACION] = "NORMAL")
										|| (CONTAINSSTRING(FlujoSel, "FES") && Fact_Tracking[CLASIFICACION] IN {"FES", "FES + SALDO"})
										|| (CONTAINSSTRING(FlujoSel, "Saldos") && Fact_Tracking[CLASIFICACION] = "SALDO")
								)
								&& (ISBLANK(ZonaSel) || Fact_Tracking[ZONA] = ZonaSel)
								&& (NOT TieneRango || (Fact_Tracking[DIAS_INTERNOS_DH] >= MinDH && (ISBLANK(MaxDH) || Fact_Tracking[DIAS_INTERNOS_DH] <= MaxDH)))
						)
					)
				)
			RETURN
				IF(
					EsNivelIntegral,
					[RE P90 contexto DH],
					CALCULATE(
						PERCENTILEX.INC(
							FILTER(
								Fact_Hitos_Operacionales,
								Fact_Hitos_Operacionales[TIENE_DATO] = TRUE()
									&& Fact_Hitos_Operacionales[METRICA_CODIGO] = Codigo
							),
							Fact_Hitos_Operacionales[DIAS_HABILES],
							0.9
						),
						REMOVEFILTERS(Config_SLA_Hitos),
						TREATAS(PedidosCohorte, Fact_Hitos_Operacionales[PED_NUMERO_PEDIDO])
					)
				)
		formatString: 0.0 "DH"
		displayFolder: 02. Resumen Ejecutivo\05. Hitos
		lineageTag: 27000000-0000-4000-8000-000000000120

	measure 'RE Periodo contexto' =
			VAR FlujoSel = SELECTEDVALUE(Dim_Vista_Ejecutiva[Flujo])
			VAR ZonaSel = SELECTEDVALUE(Dim_Rango_Entrega[Zona])
			VAR MinDH = SELECTEDVALUE(Dim_Rango_Entrega[MinDH])
			VAR MaxDH = SELECTEDVALUE(Dim_Rango_Entrega[MaxDH])
			VAR TieneRango = HASONEVALUE(Dim_Rango_Entrega[Rango])
			VAR Cohorte =
				FILTER(
					Fact_Tracking,
					Fact_Tracking[ES_CERRADO] = TRUE()
						&& NOT ISBLANK(Fact_Tracking[DIAS_INTERNOS_DH])
						&& (ISBLANK(FlujoSel)
							|| (CONTAINSSTRING(FlujoSel, "Flujo Normal") && Fact_Tracking[CLASIFICACION] = "NORMAL")
							|| (CONTAINSSTRING(FlujoSel, "FES") && Fact_Tracking[CLASIFICACION] IN {"FES", "FES + SALDO"})
							|| (CONTAINSSTRING(FlujoSel, "Saldos") && Fact_Tracking[CLASIFICACION] = "SALDO"))
						&& (ISBLANK(ZonaSel) || Fact_Tracking[ZONA] = ZonaSel)
						&& (NOT TieneRango || (Fact_Tracking[DIAS_INTERNOS_DH] >= MinDH && (ISBLANK(MaxDH) || Fact_Tracking[DIAS_INTERNOS_DH] <= MaxDH)))
				)
			VAR MinCre = MINX(Cohorte, Fact_Tracking[PED_FECHA_HORA])
			VAR MaxCre = MAXX(Cohorte, Fact_Tracking[PED_FECHA_HORA])
			VAR FacturasValidas = FILTER(Cohorte, NOT ISBLANK(Fact_Tracking[FECHA_PRIMERA_FACTURA]) && Fact_Tracking[FECHA_PRIMERA_FACTURA] >= Fact_Tracking[PED_FECHA_HORA])
			VAR MinFac = MINX(FacturasValidas, Fact_Tracking[FECHA_PRIMERA_FACTURA])
			VAR MaxFac = MAXX(FacturasValidas, Fact_Tracking[FECHA_ULTIMA_FACTURA])
			VAR CierresValidos = FILTER(Cohorte, NOT ISBLANK(Fact_Tracking[FECHA_CIERRE]) && Fact_Tracking[FECHA_CIERRE] >= Fact_Tracking[PED_FECHA_HORA])
			VAR MinCierre = MINX(CierresValidos, Fact_Tracking[FECHA_CIERRE])
			VAR MaxCierre = MAXX(CierresValidos, Fact_Tracking[FECHA_CIERRE])
			VAR Actualizado = MAXX(Cohorte, Fact_Tracking[FECHA_ACTUALIZACION])
			RETURN
				"Cohorte " & FORMAT([RE Pedidos contexto], "#,##0", "es-CL") & " pedidos · Creación " & COALESCE(FORMAT(MinCre, "dd-MM-yyyy"), "--") & " a " & COALESCE(FORMAT(MaxCre, "dd-MM-yyyy"), "--")
				& " · Factura válida " & COALESCE(FORMAT(MinFac, "dd-MM-yyyy"), "--") & " a " & COALESCE(FORMAT(MaxFac, "dd-MM-yyyy"), "--")
				& " · Cierre operativo " & COALESCE(FORMAT(MinCierre, "dd-MM-yyyy"), "--") & " a " & COALESCE(FORMAT(MaxCierre, "dd-MM-yyyy"), "--")
				& " · Último registro del set " & COALESCE(FORMAT([U Último pedido creado], "dd-MM-yyyy HH:mm"), "--")
		displayFolder: 02. Resumen Ejecutivo\06. Periodo
		lineageTag: 27000000-0000-4000-8000-000000000121

	measure 'RE Subtítulo pedidos' =
			"En SLA " & FORMAT([RE Pedidos en SLA contexto], "#,##0", "es-CL")
			& "  ·  Fuera " & FORMAT([RE Pedidos fuera SLA contexto], "#,##0", "es-CL")
			& "  ·  Cohorte única"
		displayFolder: 02. Resumen Ejecutivo\07. Texto
