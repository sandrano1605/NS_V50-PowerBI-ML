	measure 'RE Participación rango %' =
			VAR EsDetalle = ISINSCOPE(Dim_Rango_Entrega[Rango])
			VAR TotalZona =
				CALCULATE(
					[RE Pedidos contexto],
					REMOVEFILTERS(Dim_Rango_Entrega[Rango]),
					REMOVEFILTERS(Dim_Rango_Entrega[MinDH]),
					REMOVEFILTERS(Dim_Rango_Entrega[MaxDH]),
					REMOVEFILTERS(Dim_Rango_Entrega[OrdenRango])
				)
			RETURN IF(EsDetalle, DIVIDE([RE Pedidos contexto], TotalZona), 1)
		formatString: 0.0%;-0.0%;0.0%
