	measure 'FA Delta NS vs Resto' = VAR NSActual = [FA NS %] VAR NSResto = CALCULATE([FA NS %], REMOVEFILTERS(Dim_Fecha[Momento_Mes]), TREATAS({"Resto del mes"}, Dim_Fecha[Momento_Mes])) RETURN IF(ISBLANK(NSActual) || ISBLANK(NSResto), BLANK(), NSActual - NSResto)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04. Análisis Fuera SLA\Carga y SLA
