	measure 'RE Fecha mínima contexto' = MINX(ALLSELECTED(Fact_Tracking), Fact_Tracking[PED_FECHA_HORA])
		formatString: dd-MM-yyyy
		displayFolder: 02. Resumen Ejecutivo\14. Ventana Temporal
		lineageTag: 27000000-0000-4000-8000-000000000150

	measure 'RE Fecha máxima contexto' = MAXX(ALLSELECTED(Fact_Tracking), Fact_Tracking[PED_FECHA_HORA])
