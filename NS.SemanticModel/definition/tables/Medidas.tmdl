	measure 'RE Subtítulo NS' =
			"Meta 90,0%  ·  Prom. " & FORMAT([RE Promedio contexto DH], "0.0", "es-CL") & " DH"
			& "  ·  P90 " & FORMAT([RE P90 contexto DH], "0.0", "es-CL") & " DH"
