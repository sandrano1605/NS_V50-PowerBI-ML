		lineageTag: a69e655d-4b4c-4d9d-bbeb-3bdef8f7369b

	measure 'FA Arrastre Mes Siguiente' = CALCULATE( [RE Pedidos contexto], KEEPFILTERS(Fact_Tracking[CLASIFICACION] IN {"FES", "FES + SALDO"}), KEEPFILTERS( FILTER( Fact_Tracking, NOT ISBLANK(Fact_Tracking[PED_FECHA]) && NOT ISBLANK(Fact_Tracking[FECHA_CIERRE]) && EOMONTH(Fact_Tracking[FECHA_CIERRE], 0) > EOMONTH(Fact_Tracking[PED_FECHA], 0) ) ) )
