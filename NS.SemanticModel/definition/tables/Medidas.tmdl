	measure 'RE Estado último mes' =
			VAR FechaMax = [RE Fecha máxima contexto]
			VAR FinMes = EOMONTH(FechaMax, 0)
			RETURN
				IF(
					ISBLANK(FechaMax),
					BLANK(),
					IF(
						FechaMax < FinMes,
						"Último mes parcial",
						"Último mes completo"
					)
				)
		displayFolder: 02. Resumen Ejecutivo\14. Ventana Temporal
		lineageTag: 818ab90d-4ecb-4163-b52b-97af5bb80213

	measure 'RE Ventana análisis texto' =
			VAR FechaMin = [RE Fecha mínima contexto]
			VAR FechaMax = [RE Fecha máxima contexto]
			VAR Meses =
				DATEDIFF(
					DATE(YEAR(FechaMin), MONTH(FechaMin), 1),
					DATE(YEAR(FechaMax), MONTH(FechaMax), 1),
					MONTH
				) + 1
			RETURN
				IF(
					ISBLANK(FechaMin) || ISBLANK(FechaMax),
					"Sin datos en el contexto seleccionado",
					"Período analizado: "
						& FORMAT(FechaMin, "dd-MM-yyyy")
						& " al "
						& FORMAT(FechaMax, "dd-MM-yyyy")
						& " · "
						& FORMAT(Meses, "0")
						& " meses · "
						& [RE Estado último mes]
				)
		displayFolder: 02. Resumen Ejecutivo\14. Ventana Temporal
		lineageTag: a05dd22d-ee32-4c06-a3dd-b846de9f6c77

