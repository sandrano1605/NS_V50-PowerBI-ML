				            {"CREACION_COMERCIAL", "Creación → Comercial/SAC", "Administrativo", "Comercial / SAC", 20, 1, "CONTROL NO ADITIVO", true, "Subproceso contenido dentro del macro SLA administrativo de 1 DH"},
				            {"COMERCIAL_CREDITO", "Comercial/SAC → Crédito", "Administrativo", "Crédito y Cobranzas", 30, 1, "CONTROL NO ADITIVO", true, "Subproceso contenido dentro del macro SLA administrativo de 1 DH"},
				            {"CREDITO_ENTREGA", "Crédito → Ingreso a Logística", "Administrativo", "Crédito / Logística", 40, 1, "CONTROL NO ADITIVO", true, "La suma de subprocesos no reemplaza el macro SLA administrativo"},
				            {"ADMIN_TOTAL", "Creación → Ingreso a Logística", "Administrativo", "Comercial / Crédito", 45, 1, "KPI MACRO", true, "Primer gran bloque: liberación administrativa completa en 1 DH"},
				            {"ENTREGA_FACTURACION", "Ingreso a Logística → Facturación", "Operaciones", "Operaciones", 50, 3, "TRAMO", true, "Preparación interna y facturación dentro del macro SLA operacional"},
				            {"FACTURACION_DESPACHO", "Facturación → Despacho", "Operaciones", "Operaciones / Transporte", 60, 1, "TRAMO", true, "Cierra con el último despacho válido"},
				            {"OPERACIONES_TOTAL", "Ingreso a Logística → Salida oficial", "Operaciones", "Operaciones / Transporte", 70, 4, "KPI MACRO", true, "Meta zonal aplicada en Fact_Hitos: 3 DH Santiago y 4 DH Regiones hasta despacho o manifiesto FES"},
				            {"MAYORISTA_CIERRE_TOTAL", "Creación → Salida oficial", "Flujo integral", "Interáreas", 80, null, "DIAGNÓSTICO INTEGRAL", false, "No usar como promesa; la medición oficial comienza en la fecha efectiva y aplica SLA por zona"},
				            {"FES_CREACION_PED_POST", "FES: Creación original → Pedido para despacho", "FES", "Interáreas", 110, 4, "DIAGNÓSTICO FES", false, "Acumula el proceso hasta factura/pedido posterior; no es un tramo adicional"},
				            {"FES_FACT_PED_POST", "FES: Facturación → Pedido para despacho", "Operaciones", "Operaciones / Comercial", 115, 0, "CONTROL MISMO DÍA", true, "El pedido posterior debe generarse el mismo día de la factura"},
				            {"FES_PED_POST_ENT_POST", "FES: Pedido para despacho → Entrega posterior", "Operaciones", "Logística", 120, 0, "CONTROL MISMO DÍA", true, "Conversión operativa esperada el mismo día"},
				            {"FES_ENT_POST_MANIFIESTO", "FES: Entrega posterior → Manifiesto", "Operaciones", "Operaciones / Transporte", 130, 1, "TRAMO FES", true, "El manifiesto es la salida oficial FES"},
				            {"FES_CIERRE_TOTAL", "FES: Creación → Último manifiesto", "Flujo integral", "Interáreas", 140, null, "DIAGNÓSTICO FES", false, "Auditoría del cierre real FES; integra el universo único y usa el último manifiesto como salida oficial"},
				            {"FES_BRECHA_SALIDA", "FES: Primer → Último manifiesto", "FES / Saldo", "Operaciones / Transporte", 150, 1, "FRAGMENTACIÓN", true, "Brecha de salidas; no se suma al SLA integral"}
