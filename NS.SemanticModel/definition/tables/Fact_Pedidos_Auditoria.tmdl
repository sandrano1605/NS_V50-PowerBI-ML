	partition Fact_Pedidos_Auditoria = m
		mode: import
		source =
				let
				    Origen =
				        Sql.Database(
				            "128.1.3.21",
				            "DMF_VTA_PRD",
				            [
				                Query =
				"SET NOCOUNT ON;
				SET XACT_ABORT ON;
				
				DECLARE @FechaHasta      DATE          = CAST(GETDATE() AS DATE);
				
				-- Últimos tres meses móviles.
				-- Ejemplo: si hoy es 30-07-2026, inicia el 30-04-2026.
				DECLARE @FechaDesde      DATE          = DATEADD(MONTH, -3, @FechaHasta);
				
				DECLARE @Pedido          VARCHAR(20)   = NULL;
				DECLARE @HorasJornada    DECIMAL(10,2) = 9.50;
				DECLARE @SLA_Normal_Dias INT           = 5;
				
				IF @FechaDesde IS NULL
				   OR @FechaHasta IS NULL
				   OR @FechaDesde > @FechaHasta
				BEGIN
				    RAISERROR('El rango de fechas no es válido.', 16, 1);
				    RETURN;
				END;
				
				-- =====================================================================
				-- CLASIFICACIÓN OFICIAL Y TRAZABILIDAD REAL DE PEDIDOS FES
				-- Regla FES: el pedido original aparece en VBFA con flujo C -> C.
				-- Se agregan las primeras y últimas fechas del pedido posterior,
				-- entrega posterior y manifiesto asociado.
				-- =====================================================================
				IF OBJECT_ID('tempdb..#PedidosFES_AUD_V3') IS NOT NULL
				    DROP TABLE #PedidosFES_AUD_V3;
				
				CREATE TABLE #PedidosFES_AUD_V3
				(
				    PEDIDO_ORIGINAL_NUM                  BIGINT NOT NULL,
				    PRIMERA_FECHA_PEDIDO_POSTERIOR       DATE NULL,
				    ULTIMA_FECHA_PEDIDO_POSTERIOR        DATE NULL,
				    PRIMERA_FECHA_ENTREGA_POSTERIOR      DATE NULL,
				    ULTIMA_FECHA_ENTREGA_POSTERIOR       DATE NULL,
				    PRIMERA_FECHA_MANIFIESTO             DATE NULL,
				    ULTIMA_FECHA_MANIFIESTO              DATE NULL
				);
				
				;WITH PedidosPosteriores AS
				(
				    SELECT DISTINCT
				        TRY_CONVERT(BIGINT, P1.VBELV) AS PEDIDO_ORIGINAL_NUM,
				        CONVERT(VARCHAR(20), P1.VBELN) AS PEDIDO_POSTERIOR,
				        COALESCE
				        (
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P1.ERDAT), 112),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P1.ERDAT), 105),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P1.ERDAT), 103),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P1.ERDAT))
				        ) AS FECHA_PEDIDO_POSTERIOR
				    FROM [DMF_VTA_PRD].[dbo].[VBFA_SAP] AS P1
				    WHERE P1.VBTYP_V = 'C'
				      AND P1.VBTYP_N = 'C'
				      AND TRY_CONVERT(BIGINT, P1.VBELV) IS NOT NULL
				),
				ResumenPedidos AS
				(
				    SELECT
				        PEDIDO_ORIGINAL_NUM,
				        MIN(FECHA_PEDIDO_POSTERIOR) AS PRIMERA_FECHA_PEDIDO_POSTERIOR,
				        MAX(FECHA_PEDIDO_POSTERIOR) AS ULTIMA_FECHA_PEDIDO_POSTERIOR
				    FROM PedidosPosteriores
				    GROUP BY PEDIDO_ORIGINAL_NUM
				),
				EntregasPosteriores AS
				(
				    SELECT DISTINCT
				        PP.PEDIDO_ORIGINAL_NUM,
				        PP.PEDIDO_POSTERIOR,
				        CONVERT(VARCHAR(20), P2.VBELN) AS ENTREGA_POSTERIOR,
				        COALESCE
				        (
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P2.ERDAT), 112),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P2.ERDAT), 105),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P2.ERDAT), 103),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), P2.ERDAT))
				        ) AS FECHA_ENTREGA_POSTERIOR
				    FROM PedidosPosteriores AS PP
				    INNER JOIN [DMF_VTA_PRD].[dbo].[VBFA_SAP] AS P2
				        ON TRY_CONVERT(BIGINT, P2.VBELV)
				         = TRY_CONVERT(BIGINT, PP.PEDIDO_POSTERIOR)
				       AND P2.VBTYP_V = 'C'
				       AND P2.VBTYP_N = 'J'
				),
				ResumenEntregas AS
				(
				    SELECT
				        PEDIDO_ORIGINAL_NUM,
				        MIN(FECHA_ENTREGA_POSTERIOR) AS PRIMERA_FECHA_ENTREGA_POSTERIOR,
				        MAX(FECHA_ENTREGA_POSTERIOR) AS ULTIMA_FECHA_ENTREGA_POSTERIOR
				    FROM EntregasPosteriores
				    GROUP BY PEDIDO_ORIGINAL_NUM
				),
				Manifiestos AS
				(
				    SELECT DISTINCT
				        EP.PEDIDO_ORIGINAL_NUM,
				        EP.ENTREGA_POSTERIOR,
				        COALESCE
				        (
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), VTTP.ERDAT), 112),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), VTTP.ERDAT), 105),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), VTTP.ERDAT), 103),
				            TRY_CONVERT(DATE, CONVERT(VARCHAR(30), VTTP.ERDAT))
				        ) AS FECHA_MANIFIESTO
				    FROM EntregasPosteriores AS EP
				    INNER JOIN [DMF_VTA_PRD].[dbo].[VTTP_SAP] AS VTTP
				        ON TRY_CONVERT(BIGINT, VTTP.VBELN)
				         = TRY_CONVERT(BIGINT, EP.ENTREGA_POSTERIOR)
				),
				ResumenManifiestos AS
				(
				    SELECT
				        PEDIDO_ORIGINAL_NUM,
				        MIN(FECHA_MANIFIESTO) AS PRIMERA_FECHA_MANIFIESTO,
				        MAX(FECHA_MANIFIESTO) AS ULTIMA_FECHA_MANIFIESTO
				    FROM Manifiestos
				    GROUP BY PEDIDO_ORIGINAL_NUM
				)
				INSERT INTO #PedidosFES_AUD_V3
				(
				    PEDIDO_ORIGINAL_NUM,
				    PRIMERA_FECHA_PEDIDO_POSTERIOR,
				    ULTIMA_FECHA_PEDIDO_POSTERIOR,
				    PRIMERA_FECHA_ENTREGA_POSTERIOR,
				    ULTIMA_FECHA_ENTREGA_POSTERIOR,
				    PRIMERA_FECHA_MANIFIESTO,
				    ULTIMA_FECHA_MANIFIESTO
				)
				SELECT
				    RP.PEDIDO_ORIGINAL_NUM,
				    RP.PRIMERA_FECHA_PEDIDO_POSTERIOR,
				    RP.ULTIMA_FECHA_PEDIDO_POSTERIOR,
				    RE.PRIMERA_FECHA_ENTREGA_POSTERIOR,
				    RE.ULTIMA_FECHA_ENTREGA_POSTERIOR,
				    RM.PRIMERA_FECHA_MANIFIESTO,
				    RM.ULTIMA_FECHA_MANIFIESTO
				FROM ResumenPedidos AS RP
				LEFT JOIN ResumenEntregas AS RE
				    ON RE.PEDIDO_ORIGINAL_NUM = RP.PEDIDO_ORIGINAL_NUM
				LEFT JOIN ResumenManifiestos AS RM
				    ON RM.PEDIDO_ORIGINAL_NUM = RP.PEDIDO_ORIGINAL_NUM;
				
				CREATE UNIQUE CLUSTERED INDEX IX_PedidosFES_AUD_V3_PedidoOriginal
				    ON #PedidosFES_AUD_V3 (PEDIDO_ORIGINAL_NUM);
				
				IF OBJECT_ID('tempdb..#BaseAnalisis_AUD_V3') IS NOT NULL
				    DROP TABLE #BaseAnalisis_AUD_V3;
				
				;WITH Base AS
				(
				    SELECT
				        CONVERT(VARCHAR(20), ZVBELN_PED) AS ID_FILA,
				
				        ZVBELN_PED,
				        ZVTGEW,
				        ZWERKS,
				        ZPERNR,
				        ZCITYC,
				        ZREGIO,
				        ZVSBED,
				        BSTKD_M,
				        ZNETWR,
				        ZLIFSK,
				        ZCMGST,
				        ZKUNNR,
				        ZTPO_SERV,
				        ZTPO_SERVP,
				        Z_OTIF_OT,
				        ZWAERS,
				        [TEXT],
				
				        ZERDAT_PED,
				        ZERZET_PED,
				
				        ZP_UDATE_PDA,
				        ZP_UTIME_PDA,
				
				        ZP_ERDAT_COM,
				        ZP_ERZET_COM,
				        ZU_ERDAT_COM,
				        ZU_ERZET_COM,
				
				        ZP_UDATE_CRD,
				        ZP_UTIME_CRD,
				
				        ZP_UDATE_GER,
				        ZP_UTIME_GER,
				
				        ZP_ERDAT_ENT,
				        ZP_ERZET_ENT,
				        ZU_ERDAT_ENT,
				        ZU_ERZET_ENT,
				
				        ZP_ERDAT_PIC,
				        ZP_ERZET_PIC,
				        ZU_ERDAT_PIC,
				        ZU_ERZET_PIC,
				
				        ZP_ERDAT_PAC,
				        ZP_UZEIT_PAC,
				        ZU_ERDAT_PAC,
				        ZU_UZEIT_PAC,
				
				        ZP_ERDAT_FAC,
				        ZP_UZEIT_FAC,
				        ZU_ERDAT_FAC,
				        ZU_UZEIT_FAC,
				
				        ZP_ERDAT_TRP,
				        ZP_UZEIT_TRP,
				        ZU_ERDAT_TRP,
				        ZU_UZEIT_TRP,
				
				        ZP_ERDAT_TSTTO,
				        ZP_UZEIT_TSTTO,
				        ZU_ERDAT_TSTTO,
				        ZU_UZEIT_TSTTO,
				
				        ZP_ERDAT_CED,
				        ZP_ERZET_CED,
				        ZU_ERDAT_CED,
				        ZU_ERZET_CED,
				
				        Z_COPIAS_CED
				
				    FROM [DMF_VTA_PRD].[dbo].[ZART_TRACK_DATA_SAP]
				
				    WHERE
				        (
				            @Pedido IS NULL
				            OR TRY_CONVERT(BIGINT, ZVBELN_PED)
				               = TRY_CONVERT(BIGINT, @Pedido)
				        )
				        AND COALESCE
				        (
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), ''),
				                112
				            ),
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), ''),
				                103
				            ),
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), '')
				            )
				        ) >= @FechaDesde
				        AND COALESCE
				        (
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), ''),
				                112
				            ),
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), ''),
				                103
				            ),
				            TRY_CONVERT
				            (
				                DATE,
				                NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), ZERDAT_PED))), '')
				            )
				        ) < DATEADD(DAY, 1, @FechaHasta)
				),
				Eventos AS
				(
				    SELECT
				        B.ID_FILA,
				        E.CODIGO_EVENTO,
				
				        CASE
				            WHEN P.FECHA_CONVERTIDA IS NULL THEN NULL
				            ELSE DATEADD
				            (
				                SECOND,
				                DATEDIFF
				                (
				                    SECOND,
				                    CAST('00:00:00' AS TIME(0)),
				                    COALESCE
				                    (
				                        P.HORA_CONVERTIDA,
				                        CAST('00:00:00' AS TIME(0))
				                    )
				                ),
				                CAST(P.FECHA_CONVERTIDA AS DATETIME2(0))
				            )
				        END AS FECHA_HORA
				
				    FROM Base AS B
				
				    CROSS APPLY
				    (
				        VALUES
				            (
				                'PED',
				                CONVERT(VARCHAR(30), B.ZERDAT_PED),
				                CONVERT(VARCHAR(30), B.ZERZET_PED)
				            ),
				            (
				                'PDA_P',
				                CONVERT(VARCHAR(30), B.ZP_UDATE_PDA),
				                CONVERT(VARCHAR(30), B.ZP_UTIME_PDA)
				            ),
				            (
				                'COM_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_COM),
				                CONVERT(VARCHAR(30), B.ZP_ERZET_COM)
				            ),
				            (
				                'COM_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_COM),
				                CONVERT(VARCHAR(30), B.ZU_ERZET_COM)
				            ),
				            (
				                'CRD_P',
				                CONVERT(VARCHAR(30), B.ZP_UDATE_CRD),
				                CONVERT(VARCHAR(30), B.ZP_UTIME_CRD)
				            ),
				            (
				                'GER_P',
				                CONVERT(VARCHAR(30), B.ZP_UDATE_GER),
				                CONVERT(VARCHAR(30), B.ZP_UTIME_GER)
				            ),
				            (
				                'ENT_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_ENT),
				                CONVERT(VARCHAR(30), B.ZP_ERZET_ENT)
				            ),
				            (
				                'ENT_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_ENT),
				                CONVERT(VARCHAR(30), B.ZU_ERZET_ENT)
				            ),
				            (
				                'PIC_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_PIC),
				                CONVERT(VARCHAR(30), B.ZP_ERZET_PIC)
				            ),
				            (
				                'PIC_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_PIC),
				                CONVERT(VARCHAR(30), B.ZU_ERZET_PIC)
				            ),
				            (
				                'PAC_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_PAC),
				                CONVERT(VARCHAR(30), B.ZP_UZEIT_PAC)
				            ),
				            (
				                'PAC_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_PAC),
				                CONVERT(VARCHAR(30), B.ZU_UZEIT_PAC)
				            ),
				            (
				                'FAC_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_FAC),
				                CONVERT(VARCHAR(30), B.ZP_UZEIT_FAC)
				            ),
				            (
				                'FAC_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_FAC),
				                CONVERT(VARCHAR(30), B.ZU_UZEIT_FAC)
				            ),
				            (
				                'TRP_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_TRP),
				                CONVERT(VARCHAR(30), B.ZP_UZEIT_TRP)
				            ),
				            (
				                'TRP_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_TRP),
				                CONVERT(VARCHAR(30), B.ZU_UZEIT_TRP)
				            ),
				            (
				                'TSTTO_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_TSTTO),
				                CONVERT(VARCHAR(30), B.ZP_UZEIT_TSTTO)
				            ),
				            (
				                'TSTTO_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_TSTTO),
				                CONVERT(VARCHAR(30), B.ZU_UZEIT_TSTTO)
				            ),
				            (
				                'CED_P',
				                CONVERT(VARCHAR(30), B.ZP_ERDAT_CED),
				                CONVERT(VARCHAR(30), B.ZP_ERZET_CED)
				            ),
				            (
				                'CED_U',
				                CONVERT(VARCHAR(30), B.ZU_ERDAT_CED),
				                CONVERT(VARCHAR(30), B.ZU_ERZET_CED)
				            )
				    ) AS E
				    (
				        CODIGO_EVENTO,
				        FECHA_ORIGINAL,
				        HORA_ORIGINAL
				    )
				
				    OUTER APPLY
				    (
				        SELECT
				            COALESCE
				            (
				                TRY_CONVERT
				                (
				                    DATE,
				                    NULLIF(LTRIM(RTRIM(E.FECHA_ORIGINAL)), ''),
				                    112
				                ),
				                TRY_CONVERT
				                (
				                    DATE,
				                    NULLIF(LTRIM(RTRIM(E.FECHA_ORIGINAL)), ''),
				                    103
				                ),
				                TRY_CONVERT
				                (
				                    DATE,
				                    NULLIF(LTRIM(RTRIM(E.FECHA_ORIGINAL)), '')
				                )
				            ) AS FECHA_CONVERTIDA,
				
				            COALESCE
				            (
				                TRY_CONVERT
				                (
				                    TIME(0),
				                    NULLIF(LTRIM(RTRIM(E.HORA_ORIGINAL)), '')
				                ),
				                TRY_CONVERT
				                (
				                    TIME(0),
				                    STUFF
				                    (
				                        STUFF
				                        (
				                            RIGHT
				                            (
				                                '000000' +
				                                REPLACE
				                                (
				                                    NULLIF
				                                    (
				                                        LTRIM(RTRIM(E.HORA_ORIGINAL)),
				                                        ''
				                                    ),
				                                    ':',
				                                    ''
				                                ),
				                                6
				                            ),
				                            3,
				                            0,
				                            ':'
				                        ),
				                        6,
				                        0,
				                        ':'
				                    )
				                )
				            ) AS HORA_CONVERTIDA
				    ) AS P
				),
				Hitos AS
				(
				    SELECT
				        ID_FILA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PED'
				                 THEN FECHA_HORA END) AS PED_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PDA_P'
				                 THEN FECHA_HORA END) AS PDA_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'COM_P'
				                 THEN FECHA_HORA END) AS COM_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'COM_U'
				                 THEN FECHA_HORA END) AS COM_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'CRD_P'
				                 THEN FECHA_HORA END) AS CRD_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'GER_P'
				                 THEN FECHA_HORA END) AS GER_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'ENT_P'
				                 THEN FECHA_HORA END) AS ENT_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'ENT_U'
				                 THEN FECHA_HORA END) AS ENT_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PIC_P'
				                 THEN FECHA_HORA END) AS PIC_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PIC_U'
				                 THEN FECHA_HORA END) AS PIC_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PAC_P'
				                 THEN FECHA_HORA END) AS PAC_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'PAC_U'
				                 THEN FECHA_HORA END) AS PAC_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'FAC_P'
				                 THEN FECHA_HORA END) AS FAC_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'FAC_U'
				                 THEN FECHA_HORA END) AS FAC_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'TRP_P'
				                 THEN FECHA_HORA END) AS TRP_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'TRP_U'
				                 THEN FECHA_HORA END) AS TRP_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'TSTTO_P'
				                 THEN FECHA_HORA END) AS TSTTO_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'TSTTO_U'
				                 THEN FECHA_HORA END) AS TSTTO_U_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'CED_P'
				                 THEN FECHA_HORA END) AS CED_P_FECHA_HORA,
				
				        MAX(CASE WHEN CODIGO_EVENTO = 'CED_U'
				                 THEN FECHA_HORA END) AS CED_U_FECHA_HORA
				
				    FROM Eventos
				    GROUP BY ID_FILA
				),
				Intervalos AS
				(
				    SELECT
				        H.ID_FILA,
				        D.CODIGO_DURACION,
				        D.FECHA_INICIO,
				        D.FECHA_TERMINO
				
				    FROM Hitos AS H
				
				    INNER JOIN Base AS B
				        ON B.ID_FILA = H.ID_FILA
				
				    LEFT JOIN #PedidosFES_AUD_V3 AS PF
				        ON PF.PEDIDO_ORIGINAL_NUM = TRY_CONVERT(BIGINT, B.ZVBELN_PED)
				
				    CROSS APPLY
				    (
				        VALUES
				            ('PDA_PED', H.PDA_P_FECHA_HORA, H.PED_FECHA_HORA),
				            ('PED_COM', H.PED_FECHA_HORA, H.COM_P_FECHA_HORA),
				            ('PED_CRD', H.PED_FECHA_HORA, H.CRD_P_FECHA_HORA),
				            ('COM_CRD', H.COM_P_FECHA_HORA, H.CRD_P_FECHA_HORA),
				            ('CRD_ENT', H.CRD_P_FECHA_HORA, H.ENT_P_FECHA_HORA),
				            ('CRD_FAC', H.CRD_P_FECHA_HORA, H.FAC_P_FECHA_HORA),
				            ('ENT_PIC', H.ENT_P_FECHA_HORA, H.PIC_P_FECHA_HORA),
				            ('PIC_PAC', H.PIC_P_FECHA_HORA, H.PAC_P_FECHA_HORA),
				            ('PAC_FAC', H.PAC_P_FECHA_HORA, H.FAC_P_FECHA_HORA),
				            ('PIC_FAC', H.PIC_P_FECHA_HORA, H.FAC_P_FECHA_HORA),
				            ('FAC_TRP', H.FAC_P_FECHA_HORA, H.TRP_P_FECHA_HORA),
				            ('TRP_CED', H.TRP_P_FECHA_HORA, H.CED_P_FECHA_HORA),
				            ('PED_TRP', H.PED_FECHA_HORA, H.TRP_P_FECHA_HORA),
				            ('CRD_TRP', H.CRD_P_FECHA_HORA, H.TRP_P_FECHA_HORA),
				            ('PED_TRP_U', H.PED_FECHA_HORA, H.TRP_U_FECHA_HORA),
				            ('FAC_TRP_U', H.FAC_P_FECHA_HORA, H.TRP_U_FECHA_HORA),
				            ('PED_CED', H.PED_FECHA_HORA, H.CED_P_FECHA_HORA),
				            ('ENT_P_U', H.ENT_P_FECHA_HORA, H.ENT_U_FECHA_HORA),
				            ('PIC_P_U', H.PIC_P_FECHA_HORA, H.PIC_U_FECHA_HORA),
				            ('PAC_P_U', H.PAC_P_FECHA_HORA, H.PAC_U_FECHA_HORA),
				            ('FAC_P_U', H.FAC_P_FECHA_HORA, H.FAC_U_FECHA_HORA),
				            ('TRP_P_U', H.TRP_P_FECHA_HORA, H.TRP_U_FECHA_HORA),
				
				            (
				                'FES_FAC_PED_POST_P',
				                H.FAC_P_FECHA_HORA,
				                CAST(PF.PRIMERA_FECHA_PEDIDO_POSTERIOR AS DATETIME2(0))
				            ),
				            (
				                'FES_PED_POST_ENT_POST_P',
				                CAST(PF.PRIMERA_FECHA_PEDIDO_POSTERIOR AS DATETIME2(0)),
				                CAST(PF.PRIMERA_FECHA_ENTREGA_POSTERIOR AS DATETIME2(0))
				            ),
				            (
				                'FES_ENT_POST_MAN_P',
				                CAST(PF.PRIMERA_FECHA_ENTREGA_POSTERIOR AS DATETIME2(0)),
				                COALESCE
				                (
				                    CAST(PF.PRIMERA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                    H.TRP_P_FECHA_HORA
				                )
				            ),
				            (
				                'FES_FAC_MAN_P',
				                H.FAC_P_FECHA_HORA,
				                COALESCE
				                (
				                    CAST(PF.PRIMERA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                    H.TRP_P_FECHA_HORA
				                )
				            ),
				            (
				                'FES_FAC_MAN_U',
				                H.FAC_P_FECHA_HORA,
				                COALESCE
				                (
				                    CAST(PF.ULTIMA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                    H.TRP_U_FECHA_HORA,
				                    H.TRP_P_FECHA_HORA
				                )
				            ),
				            (
				                'FES_MAN_P_U',
				                COALESCE
				                (
				                    CAST(PF.PRIMERA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                    H.TRP_P_FECHA_HORA
				                ),
				                COALESCE
				                (
				                    CAST(PF.ULTIMA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                    H.TRP_U_FECHA_HORA,
				                    H.TRP_P_FECHA_HORA
				                )
				            )
				    ) AS D
				    (
				        CODIGO_DURACION,
				        FECHA_INICIO,
				        FECHA_TERMINO
				    )
				),
				CalculoDiasHabiles AS
				(
				    SELECT
				        I.ID_FILA,
				        I.CODIGO_DURACION,
				        I.FECHA_INICIO,
				        I.FECHA_TERMINO,
				
				        CASE
				            WHEN I.FECHA_INICIO IS NULL
				              OR I.FECHA_TERMINO IS NULL
				                THEN NULL
				
				            WHEN CAST(I.FECHA_TERMINO AS DATE)
				               < CAST(I.FECHA_INICIO AS DATE)
				                THEN NULL
				
				            ELSE
				                (C.DIAS_CALENDARIO / 7) * 5
				                + R.DIAS_HABILES_RESTANTES
				        END AS DIAS_HABILES
				
				    FROM Intervalos AS I
				
				    OUTER APPLY
				    (
				        SELECT
				            DATEDIFF
				            (
				                DAY,
				                CAST(I.FECHA_INICIO AS DATE),
				                CAST(I.FECHA_TERMINO AS DATE)
				            ) AS DIAS_CALENDARIO,
				
				            (
				                (
				                    DATEDIFF
				                    (
				                        DAY,
				                        CONVERT(DATE, '19000101', 112),
				                        CAST(I.FECHA_INICIO AS DATE)
				                    ) % 7
				                ) + 7
				            ) % 7 AS DIA_SEMANA_INICIO
				    ) AS C
				
				    OUTER APPLY
				    (
				        SELECT
				            COUNT(*) AS DIAS_HABILES_RESTANTES
				        FROM
				        (
				            VALUES
				                (1),
				                (2),
				                (3),
				                (4),
				                (5),
				                (6)
				        ) AS N(NUMERO_DIA)
				        WHERE N.NUMERO_DIA <= C.DIAS_CALENDARIO % 7
				          AND (C.DIA_SEMANA_INICIO + N.NUMERO_DIA) % 7 < 5
				    ) AS R
				),
				DiasHabiles AS
				(
				    SELECT
				        ID_FILA,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PDA_PED'
				                 THEN DIAS_HABILES END) AS DH_PDA_PED,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PED_COM'
				                 THEN DIAS_HABILES END) AS DH_PED_COM,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PED_CRD'
				                 THEN DIAS_HABILES END) AS DH_PED_CRD,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'COM_CRD'
				                 THEN DIAS_HABILES END) AS DH_COM_CRD,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'CRD_ENT'
				                 THEN DIAS_HABILES END) AS DH_CRD_ENT,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'CRD_FAC'
				                 THEN DIAS_HABILES END) AS DH_CRD_FAC,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'ENT_PIC'
				                 THEN DIAS_HABILES END) AS DH_ENT_PIC,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PIC_PAC'
				                 THEN DIAS_HABILES END) AS DH_PIC_PAC,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PAC_FAC'
				                 THEN DIAS_HABILES END) AS DH_PAC_FAC,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PIC_FAC'
				                 THEN DIAS_HABILES END) AS DH_PIC_FAC,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FAC_TRP'
				                 THEN DIAS_HABILES END) AS DH_FAC_TRP,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'TRP_CED'
				                 THEN DIAS_HABILES END) AS DH_TRP_CED,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PED_TRP'
				                 THEN DIAS_HABILES END) AS DH_PED_TRP,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'CRD_TRP'
				                 THEN DIAS_HABILES END) AS DH_CRD_TRP,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PED_TRP_U'
				                 THEN DIAS_HABILES END) AS DH_PED_TRP_U,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FAC_TRP_U'
				                 THEN DIAS_HABILES END) AS DH_FAC_TRP_U,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PED_CED'
				                 THEN DIAS_HABILES END) AS DH_PED_CED,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'ENT_P_U'
				                 THEN DIAS_HABILES END) AS DH_ENT_PRIMERA_ULTIMA,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PIC_P_U'
				                 THEN DIAS_HABILES END) AS DH_PIC_PRIMERO_ULTIMO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'PAC_P_U'
				                 THEN DIAS_HABILES END) AS DH_PAC_PRIMERO_ULTIMO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FAC_P_U'
				                 THEN DIAS_HABILES END) AS DH_FAC_PRIMERA_ULTIMA,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'TRP_P_U'
				                 THEN DIAS_HABILES END) AS DH_TRP_PRIMERO_ULTIMO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_FAC_PED_POST_P'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_FACTURA_A_PRIMER_PEDIDO_POSTERIOR,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_PED_POST_ENT_POST_P'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_PRIMER_PEDIDO_A_PRIMERA_ENTREGA_POSTERIOR,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_ENT_POST_MAN_P'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_PRIMERA_ENTREGA_A_PRIMER_MANIFIESTO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_FAC_MAN_P'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_FACTURA_A_PRIMER_MANIFIESTO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_FAC_MAN_U'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_FACTURA_A_ULTIMO_MANIFIESTO,
				
				        MAX(CASE WHEN CODIGO_DURACION = 'FES_MAN_P_U'
				                 THEN DIAS_HABILES END)
				            AS DH_FES_BRECHA_PRIMER_ULTIMO_MANIFIESTO
				
				    FROM CalculoDiasHabiles
				    GROUP BY ID_FILA
				)
				SELECT
				    CONVERT(VARCHAR(20), B.ZVBELN_PED) AS PED_NUMERO_PEDIDO,
				    B.ZKUNNR                           AS PED_CODIGO_CLIENTE,
				    B.ZPERNR                           AS PED_RESPONSABLE,
				    B.ZWERKS                           AS PED_CENTRO,
				    B.ZCITYC                           AS PED_CIUDAD,
				    B.ZREGIO                           AS PED_REGION,
				
				    RIGHT
				    (
				        '00' + LTRIM(RTRIM(CONVERT(VARCHAR(10), B.ZVSBED))),
				        2
				    ) AS PED_CONDICION_EXPEDICION_CODIGO,
				
				    CASE RIGHT
				         (
				             '00' + LTRIM(RTRIM(CONVERT(VARCHAR(10), B.ZVSBED))),
				             2
				         )
				        WHEN '01' THEN 'Estándar'
				        WHEN '02' THEN 'Retira Cliente'
				        WHEN '03' THEN 'En espera'
				        WHEN '04' THEN 'Urgente'
				        WHEN '05' THEN 'Exportacion'
				        WHEN '06' THEN 'Liquiart'
				        WHEN '07' THEN 'Inventario'
				        WHEN '08' THEN 'Traslado Locales'
				        ELSE 'No clasificado'
				    END AS PED_CONDICION_EXPEDICION,
				
				    B.BSTKD_M AS PED_ORDEN_COMPRA_CLIENTE,
				
				    RIGHT
				    (
				        '00' + LTRIM(RTRIM(CONVERT(VARCHAR(10), B.ZVTGEW))),
				        2
				    ) AS PED_CANAL_CODIGO,
				
				    CASE RIGHT
				         (
				             '00' + LTRIM(RTRIM(CONVERT(VARCHAR(10), B.ZVTGEW))),
				             2
				         )
				        WHEN '40' THEN 'Supermercados'
				        WHEN '41' THEN 'Tiendas Conveniencia'
				        WHEN '42' THEN 'Instituciones'
				        WHEN '43' THEN 'Tradicional Detalle'
				        WHEN '44' THEN 'Tiendas Departamento'
				        WHEN '45' THEN 'Dist Mayoristas'
				        WHEN '46' THEN 'Org. Gubernamentales'
				        WHEN '47' THEN 'Otros'
				        ELSE 'No clasificado'
				    END AS PED_CANAL,
				
				    B.ZNETWR                           AS PED_VALOR_NETO,
				    B.ZWAERS                           AS PED_MONEDA,
				    B.ZLIFSK                           AS PED_BLOQUEO_ENTREGA,
				    B.ZCMGST                           AS PED_ESTADO_CREDITO,
				    B.ZTPO_SERV                        AS SERV_TIPO_SERVICIO,
				    B.ZTPO_SERVP                       AS SERV_TIPO_SERVICIO_PLANIFICADO,
				    B.Z_OTIF_OT                        AS OTIF_ESTADO_PEDIDO,
				    B.[TEXT]                           AS PED_TEXTO_ESTADO,
				    B.Z_COPIAS_CED                     AS CED_CANTIDAD_COPIAS,
				
				    CL.ES_FES,
				    CL.ES_SALDO,
				
				    PF.PRIMERA_FECHA_PEDIDO_POSTERIOR,
				    PF.ULTIMA_FECHA_PEDIDO_POSTERIOR,
				    PF.PRIMERA_FECHA_ENTREGA_POSTERIOR,
				    PF.ULTIMA_FECHA_ENTREGA_POSTERIOR,
				    CASE
				        WHEN CL.ES_FES = 1
				            THEN COALESCE
				                 (
				                     PF.PRIMERA_FECHA_MANIFIESTO,
				                     CAST(H.TRP_P_FECHA_HORA AS DATE)
				                 )
				        ELSE NULL
				    END AS PRIMERA_FECHA_MANIFIESTO,
				
				    CASE
				        WHEN CL.ES_FES = 1
				            THEN COALESCE
				                 (
				                     PF.ULTIMA_FECHA_MANIFIESTO,
				                     CAST(H.TRP_U_FECHA_HORA AS DATE),
				                     CAST(H.TRP_P_FECHA_HORA AS DATE)
				                 )
				        ELSE NULL
				    END AS ULTIMA_FECHA_MANIFIESTO,
				
				    CASE
				        WHEN CL.ES_FES = 1 THEN 'PEDIDO C-C EN VBFA'
				        ELSE 'SIN PEDIDO POSTERIOR C-C'
				    END AS REGLA_CLASIFICACION_FES,
				
				    CASE
				        WHEN CL.ES_SALDO = 1
				            THEN 'PRIMERA Y ULTIMA FACTURA EN FECHAS DISTINTAS'
				        ELSE 'FACTURACION EN UNA MISMA FECHA'
				    END AS REGLA_CLASIFICACION_SALDO,
				
				    CASE
				        WHEN CL.ES_FES = 1 AND CL.ES_SALDO = 1 THEN 'FES + SALDO'
				        WHEN CL.ES_SALDO = 1 THEN 'SALDO'
				        WHEN CL.ES_FES = 1 THEN 'FES'
				        ELSE 'FLUJO NORMAL'
				    END AS SEGMENTO_ANALISIS,
				
				    CASE
				        WHEN CL.ES_FES = 0 AND CL.ES_SALDO = 0
				            THEN CONVERT(BIT, 1)
				        ELSE CONVERT(BIT, 0)
				    END AS INCLUIR_SLA_NORMAL,
				
				    H.PDA_P_FECHA_HORA,
				    H.PED_FECHA_HORA,
				    H.COM_P_FECHA_HORA,
				    H.COM_U_FECHA_HORA,
				    H.CRD_P_FECHA_HORA,
				    H.GER_P_FECHA_HORA,
				    H.ENT_P_FECHA_HORA,
				    H.ENT_U_FECHA_HORA,
				    H.PIC_P_FECHA_HORA,
				    H.PIC_U_FECHA_HORA,
				    H.PAC_P_FECHA_HORA,
				    H.PAC_U_FECHA_HORA,
				    H.FAC_P_FECHA_HORA AS FAC_P_FECHA_HORA_REAL,
				    H.FAC_U_FECHA_HORA,
				    H.TRP_P_FECHA_HORA,
				    H.TRP_U_FECHA_HORA,
				    H.TSTTO_P_FECHA_HORA,
				    H.TSTTO_U_FECHA_HORA,
				    H.CED_P_FECHA_HORA,
				    H.CED_U_FECHA_HORA,
				
				    CASE
				        WHEN CL.ES_FES = 1
				            THEN COALESCE
				                 (
				                     CAST(PF.PRIMERA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                     H.TRP_P_FECHA_HORA
				                 )
				        ELSE H.FAC_P_FECHA_HORA
				    END AS FAC_FECHA_OPERATIVA_AJUSTADA,
				
				    CASE
				        WHEN CL.ES_FES = 1
				            THEN COALESCE
				                 (
				                     CAST(PF.ULTIMA_FECHA_MANIFIESTO AS DATETIME2(0)),
				                     H.TRP_U_FECHA_HORA,
				                     H.TRP_P_FECHA_HORA
				                 )
				        ELSE NULL
				    END AS FES_FECHA_CIERRE_OPERATIVO_100,
				
				    CASE
				        WHEN H.PDA_P_FECHA_HORA IS NULL
				          OR H.PED_FECHA_HORA IS NULL
				            THEN NULL
				        WHEN H.PED_FECHA_HORA < H.PDA_P_FECHA_HORA
				            THEN NULL
				        ELSE CONVERT
				        (
				            DECIMAL(18,4),
				            DATEDIFF
				            (
				                SECOND,
				                H.PDA_P_FECHA_HORA,
				                H.PED_FECHA_HORA
				            ) / 3600.0
				        )
				    END AS HRS_COMERCIAL_PDA_SAC,
				
				    CASE
				        WHEN H.PDA_P_FECHA_HORA IS NULL
				          OR H.PED_FECHA_HORA IS NULL
				            THEN NULL
				        WHEN H.PED_FECHA_HORA < H.PDA_P_FECHA_HORA
				            THEN NULL
				        ELSE CONVERT
				        (
				            DECIMAL(18,4),
				            DATEDIFF
				            (
				                SECOND,
				                H.PDA_P_FECHA_HORA,
				                H.PED_FECHA_HORA
				            ) / 3600.0 / NULLIF(@HorasJornada, 0)
				        )
				    END AS DIAS_EQ_COMERCIAL_9_5H,
				
				    DH.DH_PDA_PED AS DH_COMERCIAL_PDA_SAC,
				    DH.DH_PED_CRD AS DH_CREDITO_COBRANZAS,
				
				    DH.DH_CRD_FAC AS DH_OPERACION_INTERNA,
				    DH.DH_CRD_ENT AS DH_CREDITO_A_PRIMERA_ENTREGA,
				    DH.DH_ENT_PIC AS DH_PRIMERA_ENTREGA_A_PRIMER_PICKING,
				    DH.DH_PIC_PAC AS DH_PRIMER_PICKING_A_PRIMER_PACKING,
				    DH.DH_PAC_FAC AS DH_PRIMER_PACKING_A_PRIMERA_FACTURA,
				    DH.DH_PIC_FAC AS DH_PRIMER_PICKING_A_PRIMERA_FACTURA,
				
				    DH.DH_FAC_TRP AS DH_DESPACHO,
				    DH.DH_PED_TRP AS DH_LEAD_NORMAL,
				
				    CASE
				        WHEN CL.ES_FES = 1 OR CL.ES_SALDO = 1
				            THEN 'SEGMENTO SEPARADO'
				        WHEN DH.DH_PED_TRP IS NULL
				            THEN 'SIN DATO'
				        WHEN DH.DH_PED_TRP > @SLA_Normal_Dias
				            THEN 'FUERA SLA'
				        ELSE 'DENTRO SLA'
				    END AS ESTADO_SLA_NORMAL,
				
				    CASE
				        WHEN CL.ES_FES = 1 OR CL.ES_SALDO = 1
				            THEN 'SEGMENTO SEPARADO'
				        WHEN DH.DH_PED_TRP IS NULL
				            THEN 'SIN DATO'
				        WHEN COALESCE(DH.DH_CRD_FAC, -1)
				             >= COALESCE(DH.DH_PED_CRD, -1)
				         AND COALESCE(DH.DH_CRD_FAC, -1)
				             >= COALESCE(DH.DH_FAC_TRP, -1)
				            THEN 'OPERACION INTERNA'
				        WHEN COALESCE(DH.DH_PED_CRD, -1)
				             >= COALESCE(DH.DH_FAC_TRP, -1)
				            THEN 'CREDITO Y COBRANZAS'
				        ELSE 'DESPACHO'
				    END AS PROCESO_DOMINANTE_NORMAL,
				
				    DH.DH_CRD_TRP AS DH_FES_CREDITO_A_PRIMER_DESPACHO,
				    DH.DH_FAC_TRP AS DH_FES_FACTURA_A_PRIMER_DESPACHO,
				
				    DH.DH_FES_FACTURA_A_PRIMER_PEDIDO_POSTERIOR,
				    DH.DH_FES_PRIMER_PEDIDO_A_PRIMERA_ENTREGA_POSTERIOR,
				    DH.DH_FES_PRIMERA_ENTREGA_A_PRIMER_MANIFIESTO,
				    DH.DH_FES_FACTURA_A_PRIMER_MANIFIESTO,
				    DH.DH_FES_FACTURA_A_ULTIMO_MANIFIESTO,
				    DH.DH_FES_BRECHA_PRIMER_ULTIMO_MANIFIESTO,
				
				    DH.DH_PED_TRP_U AS DH_ENTREGA_COMPLETA_100,
				    DH.DH_TRP_PRIMERO_ULTIMO AS DH_BRECHA_PRIMER_ULTIMO_DESPACHO,
				    DH.DH_FAC_TRP_U AS DH_PRIMERA_FACTURA_A_ULTIMO_DESPACHO,
				    DH.DH_ENT_PRIMERA_ULTIMA,
				    DH.DH_PIC_PRIMERO_ULTIMO,
				    DH.DH_PAC_PRIMERO_ULTIMO,
				    DH.DH_FAC_PRIMERA_ULTIMA,
				
				    DH.DH_TRP_CED AS DH_DESPACHO_A_CEDIBLE,
				    DH.DH_PED_CED AS DH_CREACION_A_CEDIBLE,
				
				    CONVERT(CHAR(7), H.PED_FECHA_HORA, 120) AS MES_CREACION,
				    DAY(H.PED_FECHA_HORA) AS DIA_MES_CREACION,
				
				    CASE
				        WHEN DAY(H.PED_FECHA_HORA) BETWEEN 1 AND 7 THEN '01-07'
				        WHEN DAY(H.PED_FECHA_HORA) BETWEEN 8 AND 14 THEN '08-14'
				        WHEN DAY(H.PED_FECHA_HORA) BETWEEN 15 AND 21 THEN '15-21'
				        ELSE '22-FIN'
				    END AS TRAMO_MES_CALENDARIO,
				
				    CASE
				        WHEN CAST(H.PED_FECHA_HORA AS DATE)
				             >= U7.FECHA_INICIO_ULTIMOS_7
				            THEN CONVERT(BIT, 1)
				        ELSE CONVERT(BIT, 0)
				    END AS ES_ULTIMOS_7_DIAS_HABILES_MES
				
				INTO #BaseAnalisis_AUD_V3
				
				FROM Base AS B
				
				INNER JOIN Hitos AS H
				    ON H.ID_FILA = B.ID_FILA
				
				LEFT JOIN DiasHabiles AS DH
				    ON DH.ID_FILA = B.ID_FILA
				
				LEFT JOIN #PedidosFES_AUD_V3 AS PF
				    ON PF.PEDIDO_ORIGINAL_NUM =
				       TRY_CONVERT(BIGINT, B.ZVBELN_PED)
				
				CROSS APPLY
				(
				    VALUES
				    (
				        CASE
				            WHEN PF.PEDIDO_ORIGINAL_NUM IS NOT NULL
				                THEN CONVERT(BIT, 1)
				            ELSE CONVERT(BIT, 0)
				        END,
				
				        CASE
				            WHEN H.FAC_P_FECHA_HORA IS NOT NULL
				             AND H.FAC_U_FECHA_HORA IS NOT NULL
				             AND DATEDIFF
				                 (
				                     DAY,
				                     CAST(H.FAC_P_FECHA_HORA AS DATE),
				                     CAST(H.FAC_U_FECHA_HORA AS DATE)
				                 ) > 0
				                THEN CONVERT(BIT, 1)
				            ELSE CONVERT(BIT, 0)
				        END
				    )
				) AS CL
				(
				    ES_FES,
				    ES_SALDO
				)
				
				OUTER APPLY
				(
				    SELECT
				        MIN(CAL.FECHA) AS FECHA_INICIO_ULTIMOS_7
				    FROM
				    (
				        SELECT TOP (7)
				            X.FECHA
				        FROM
				        (
				            SELECT
				                DATEADD
				                (
				                    DAY,
				                    N.N,
				                    DATEADD
				                    (
				                        MONTH,
				                        DATEDIFF
				                        (
				                            MONTH,
				                            0,
				                            H.PED_FECHA_HORA
				                        ),
				                        0
				                    )
				                ) AS FECHA
				            FROM
				            (
				                SELECT TOP (31)
				                    ROW_NUMBER()
				                    OVER (ORDER BY (SELECT NULL)) - 1 AS N
				                FROM sys.all_objects
				            ) AS N
				        ) AS X
				        WHERE MONTH(X.FECHA) = MONTH(H.PED_FECHA_HORA)
				          AND YEAR(X.FECHA) = YEAR(H.PED_FECHA_HORA)
				          AND
				          (
				              (
				                  DATEDIFF
				                  (
				                      DAY,
				                      CONVERT(DATE, '19000101', 112),
				                      X.FECHA
				                  ) % 7
				                  + 7
				              ) % 7
				          ) < 5
				        ORDER BY X.FECHA DESC
				    ) AS CAL
				) AS U7;
				
				CREATE CLUSTERED INDEX IX_BaseAnalisis_AUD_V3_Pedido
				    ON #BaseAnalisis_AUD_V3 (PED_NUMERO_PEDIDO);
				
				CREATE NONCLUSTERED INDEX IX_BaseAnalisis_AUD_V3_SegmentoMes
				    ON #BaseAnalisis_AUD_V3
				    (
				        SEGMENTO_ANALISIS,
				        MES_CREACION
				    )
				    INCLUDE
				    (
				        DH_LEAD_NORMAL,
				        DH_OPERACION_INTERNA,
				        DH_DESPACHO,
				        PED_VALOR_NETO
				    );
				
				IF OBJECT_ID('tempdb..#FACT_NS_RAW_AUD_V3') IS NOT NULL
				    DROP TABLE #FACT_NS_RAW_AUD_V3;
				
				SELECT
				    B.*,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.PDA_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_PDA,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.PED_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.COM_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_COM_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.CRD_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_CRD_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.ENT_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_ENT_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.PIC_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_PIC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.PAC_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_PAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_FAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.TRP_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_TRP_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.TSTTO_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_TSTTO_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE WHEN B.CED_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				    ) AS AUD_TIENE_CED_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PDA_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.PDA_P_FECHA_HORA > B.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_PDA_DESPUES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.COM_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.COM_P_FECHA_HORA < B.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_COM_ANTES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.CRD_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.CRD_P_FECHA_HORA < B.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_CRD_ANTES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ENT_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.ENT_P_FECHA_HORA < B.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_ENT_ANTES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PIC_P_FECHA_HORA IS NOT NULL
				             AND B.ENT_P_FECHA_HORA IS NOT NULL
				             AND B.PIC_P_FECHA_HORA < B.ENT_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_PIC_ANTES_ENT,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PAC_P_FECHA_HORA IS NOT NULL
				             AND B.PIC_P_FECHA_HORA IS NOT NULL
				             AND B.PAC_P_FECHA_HORA < B.PIC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_PAC_ANTES_PIC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.PIC_P_FECHA_HORA IS NOT NULL
				             AND B.FAC_P_FECHA_HORA_REAL < B.PIC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_FAC_ANTES_PIC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.TRP_P_FECHA_HORA < B.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_TRP_ANTES_FAC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.CED_P_FECHA_HORA IS NOT NULL
				             AND B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.CED_P_FECHA_HORA < B.TRP_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_CED_ANTES_TRP,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.COM_P_FECHA_HORA IS NOT NULL
				             AND B.COM_U_FECHA_HORA IS NOT NULL
				             AND B.COM_U_FECHA_HORA < B.COM_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_COM_U_ANTES_COM_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ENT_P_FECHA_HORA IS NOT NULL
				             AND B.ENT_U_FECHA_HORA IS NOT NULL
				             AND B.ENT_U_FECHA_HORA < B.ENT_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_ENT_U_ANTES_ENT_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PIC_P_FECHA_HORA IS NOT NULL
				             AND B.PIC_U_FECHA_HORA IS NOT NULL
				             AND B.PIC_U_FECHA_HORA < B.PIC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_PIC_U_ANTES_PIC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PAC_P_FECHA_HORA IS NOT NULL
				             AND B.PAC_U_FECHA_HORA IS NOT NULL
				             AND B.PAC_U_FECHA_HORA < B.PAC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_PAC_U_ANTES_PAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.FAC_U_FECHA_HORA IS NOT NULL
				             AND B.FAC_U_FECHA_HORA < B.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_FAC_U_ANTES_FAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.TRP_U_FECHA_HORA IS NOT NULL
				             AND B.TRP_U_FECHA_HORA < B.TRP_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_TRP_U_ANTES_TRP_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TSTTO_P_FECHA_HORA IS NOT NULL
				             AND B.TSTTO_U_FECHA_HORA IS NOT NULL
				             AND B.TSTTO_U_FECHA_HORA < B.TSTTO_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_TSTTO_U_ANTES_TSTTO_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.CED_P_FECHA_HORA IS NOT NULL
				             AND B.CED_U_FECHA_HORA IS NOT NULL
				             AND B.CED_U_FECHA_HORA < B.CED_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_CED_U_ANTES_CED_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.FAC_P_FECHA_HORA_REAL
				                 < DATEADD(DAY, -30, B.PED_FECHA_HORA)
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_FAC_MAS_30_DIAS_ANTES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.TRP_P_FECHA_HORA
				                 < DATEADD(DAY, -30, B.PED_FECHA_HORA)
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_TRP_MAS_30_DIAS_ANTES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.FAC_P_FECHA_HORA_REAL
				                 > DATEADD(DAY, 365, B.PED_FECHA_HORA)
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_FAC_MAS_365_DIAS_DESPUES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.PED_FECHA_HORA IS NOT NULL
				             AND B.TRP_P_FECHA_HORA
				                 > DATEADD(DAY, 365, B.PED_FECHA_HORA)
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_TRP_MAS_365_DIAS_DESPUES_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN COALESCE
				                 (
				                     B.CED_U_FECHA_HORA,
				                     B.CED_P_FECHA_HORA,
				                     B.TRP_U_FECHA_HORA,
				                     B.TRP_P_FECHA_HORA,
				                     B.FAC_U_FECHA_HORA,
				                     B.FAC_P_FECHA_HORA_REAL
				                 ) > DATEADD(DAY, 1, GETDATE())
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_INC_HITO_FECHA_FUTURA,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PED_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.PED_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_PED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.COM_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.COM_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_COM,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.CRD_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.CRD_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_CRD,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ENT_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.ENT_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_ENT,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PIC_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.PIC_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_PIC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.PAC_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.PAC_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_PAC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND CONVERT(TIME(0), B.FAC_P_FECHA_HORA_REAL) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_FAC,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.TRP_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.TRP_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_TRP,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.CED_P_FECHA_HORA IS NOT NULL
				             AND CONVERT(TIME(0), B.CED_P_FECHA_HORA) = '00:00:00'
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_HORA_00_CED,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_SIN_FECHA_PEDIDO_POSTERIOR,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_SIN_ENTREGA_POSTERIOR,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_MANIFIESTO IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_SIN_MANIFIESTO,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL
				             AND B.PRIMERA_FECHA_PEDIDO_POSTERIOR
				                 < CAST(B.FAC_P_FECHA_HORA_REAL AS DATE)
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_PEDIDO_POST_ANTES_FACTURA,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL
				             AND B.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL
				             AND B.PRIMERA_FECHA_ENTREGA_POSTERIOR
				                 < B.PRIMERA_FECHA_PEDIDO_POSTERIOR
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_ENTREGA_ANTES_PEDIDO_POST,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL
				             AND B.PRIMERA_FECHA_MANIFIESTO IS NOT NULL
				             AND B.PRIMERA_FECHA_MANIFIESTO
				                 < B.PRIMERA_FECHA_ENTREGA_POSTERIOR
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_MANIFIESTO_ANTES_ENTREGA,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL
				             AND B.ULTIMA_FECHA_PEDIDO_POSTERIOR IS NOT NULL
				             AND B.ULTIMA_FECHA_PEDIDO_POSTERIOR
				                 < B.PRIMERA_FECHA_PEDIDO_POSTERIOR
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_ULT_PEDIDO_ANTES_PRIMERO,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL
				             AND B.ULTIMA_FECHA_ENTREGA_POSTERIOR IS NOT NULL
				             AND B.ULTIMA_FECHA_ENTREGA_POSTERIOR
				                 < B.PRIMERA_FECHA_ENTREGA_POSTERIOR
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_ULT_ENTREGA_ANTES_PRIMERA,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.PRIMERA_FECHA_MANIFIESTO IS NOT NULL
				             AND B.ULTIMA_FECHA_MANIFIESTO IS NOT NULL
				             AND B.ULTIMA_FECHA_MANIFIESTO
				                 < B.PRIMERA_FECHA_MANIFIESTO
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_ULT_MANIFIESTO_ANTES_PRIMERO,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 1
				             AND B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.PRIMERA_FECHA_MANIFIESTO IS NOT NULL
				             AND DATEDIFF
				                 (
				                     DAY,
				                     CAST(B.FAC_P_FECHA_HORA_REAL AS DATE),
				                     B.PRIMERA_FECHA_MANIFIESTO
				                 ) > 60
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_FES_CICLO_MAYOR_60_DIAS,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 0
				             AND
				             (
				                 B.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL
				                 OR B.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL
				                 OR B.PRIMERA_FECHA_MANIFIESTO IS NOT NULL
				             )
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_NO_FES_CON_FECHAS_FES,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_FES = 0
				             AND
				             (
				                 B.DH_FES_FACTURA_A_PRIMER_PEDIDO_POSTERIOR IS NOT NULL
				                 OR B.DH_FES_PRIMER_PEDIDO_A_PRIMERA_ENTREGA_POSTERIOR IS NOT NULL
				                 OR B.DH_FES_PRIMERA_ENTREGA_A_PRIMER_MANIFIESTO IS NOT NULL
				                 OR B.DH_FES_FACTURA_A_PRIMER_MANIFIESTO IS NOT NULL
				                 OR B.DH_FES_FACTURA_A_ULTIMO_MANIFIESTO IS NOT NULL
				             )
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_NO_FES_CON_METRICAS_FES,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_SALDO = 1
				             AND B.FAC_P_FECHA_HORA_REAL IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_SALDO_SIN_FAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_SALDO = 1
				             AND B.FAC_U_FECHA_HORA IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_SALDO_SIN_FAC_U,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_SALDO = 1
				             AND B.TRP_U_FECHA_HORA IS NULL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_SALDO_SIN_TRP_U,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_SALDO = 1
				             AND B.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND B.FAC_U_FECHA_HORA IS NOT NULL
				             AND B.FAC_U_FECHA_HORA < B.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_SALDO_FAC_U_ANTES_FAC_P,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN B.ES_SALDO = 1
				             AND B.TRP_P_FECHA_HORA IS NOT NULL
				             AND B.TRP_U_FECHA_HORA IS NOT NULL
				             AND B.TRP_U_FECHA_HORA < B.TRP_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_SALDO_TRP_U_ANTES_TRP_P,
				
				    @FechaDesde AS PARAM_FECHA_DESDE,
				    @FechaHasta AS PARAM_FECHA_HASTA,
				    GETDATE()   AS FECHA_CARGA_MASTER
				
				INTO #FACT_NS_RAW_AUD_V3
				FROM #BaseAnalisis_AUD_V3 AS B;
				
				IF OBJECT_ID('tempdb..#FACT_NS_MASTER_AUD_V3') IS NOT NULL
				    DROP TABLE #FACT_NS_MASTER_AUD_V3;
				
				SELECT
				    M.*,
				
				    A.HITOS_ESPERADOS AS AUD_HITOS_OBLIGATORIOS_ESPERADOS,
				    A.HITOS_PRESENTES AS AUD_CANTIDAD_HITOS_PRESENTES,
				
				    A.HITOS_ESPERADOS
				        - A.HITOS_PRESENTES AS AUD_CANTIDAD_HITOS_FALTANTES,
				
				    CONVERT
				    (
				        DECIMAL(9,2),
				        A.HITOS_PRESENTES * 100.0
				        / NULLIF(A.HITOS_ESPERADOS, 0)
				    ) AS AUD_PCT_COBERTURA_HITOS,
				
				    7 AS AUD_HITOS_OPCIONALES_ESPERADOS,
				
				    A.HITOS_OPCIONALES_PRESENTES
				        AS AUD_HITOS_OPCIONALES_PRESENTES,
				
				    7 - A.HITOS_OPCIONALES_PRESENTES
				        AS AUD_HITOS_OPCIONALES_FALTANTES,
				
				    CONVERT
				    (
				        DECIMAL(9,2),
				        A.HITOS_OPCIONALES_PRESENTES * 100.0 / 7.0
				    ) AS AUD_PCT_COBERTURA_OPCIONAL,
				
				    A.CRITICAS_NORMAL
				        AS AUD_CRITICAS_FLUJO_NORMAL,
				
				    A.ADVERTENCIAS_NORMAL
				        AS AUD_ADVERTENCIAS_FLUJO_NORMAL,
				
				    A.CRITICAS_PRIMERO_ULTIMO
				        AS AUD_CRITICAS_PRIMERO_ULTIMO,
				
				    A.ADVERTENCIAS_PRIMERO_ULTIMO
				        AS AUD_ADVERTENCIAS_PRIMERO_ULTIMO,
				
				    A.CRITICAS_ATIPICAS
				        AS AUD_ALERTAS_FECHAS_ATIPICAS,
				
				    A.ALERTAS_HORA_00
				        AS AUD_ALERTAS_HORA_00,
				
				    A.CRITICAS_FES
				        AS AUD_CRITICAS_FES,
				
				    A.ADVERTENCIAS_FES
				        AS AUD_ADVERTENCIAS_FES,
				
				    A.FALTANTES_FES
				        AS AUD_FALTANTES_FES,
				
				    A.CRITICAS_SALDO
				        AS AUD_CRITICAS_SALDO,
				
				    A.ADVERTENCIAS_SALDO
				        AS AUD_ADVERTENCIAS_SALDO,
				
				    A.FALTANTES_SALDO
				        AS AUD_FALTANTES_SALDO,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN M.PDA_P_FECHA_HORA IS NOT NULL
				             AND M.PED_FECHA_HORA IS NOT NULL
				             AND M.PDA_P_FECHA_HORA > M.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				    ) AS AUD_OBS_PDA_DESPUES_PEDIDO,
				
				    A.CRITICAS_NORMAL
				        + A.CRITICAS_PRIMERO_ULTIMO
				        + A.CRITICAS_ATIPICAS
				        + A.CRITICAS_FES
				        + A.CRITICAS_SALDO
				            AS AUD_TOTAL_CRITICAS,
				
				    A.ADVERTENCIAS_NORMAL
				        + A.ADVERTENCIAS_PRIMERO_ULTIMO
				        + A.ALERTAS_HORA_00
				        + A.ADVERTENCIAS_FES
				        + A.FALTANTES_FES
				        + A.ADVERTENCIAS_SALDO
				        + A.FALTANTES_SALDO
				        + CASE
				              WHEN M.INCLUIR_SLA_NORMAL = 1
				                  THEN A.FALTANTES_NORMAL
				              ELSE 0
				          END
				            AS AUD_TOTAL_ADVERTENCIAS,
				
				    A.CRITICAS_NORMAL
				        + A.CRITICAS_PRIMERO_ULTIMO
				        + A.CRITICAS_ATIPICAS
				        + A.CRITICAS_FES
				        + A.CRITICAS_SALDO
				        + A.ADVERTENCIAS_NORMAL
				        + A.ADVERTENCIAS_PRIMERO_ULTIMO
				        + A.ALERTAS_HORA_00
				        + A.ADVERTENCIAS_FES
				        + A.FALTANTES_FES
				        + A.ADVERTENCIAS_SALDO
				        + A.FALTANTES_SALDO
				        + CASE
				              WHEN M.INCLUIR_SLA_NORMAL = 1
				                  THEN A.FALTANTES_NORMAL
				              ELSE 0
				          END
				            AS AUD_TOTAL_INCONGRUENCIAS,
				
				    CONVERT
				    (
				        BIT,
				        CASE
				            WHEN A.CRITICAS_NORMAL
				               + A.CRITICAS_PRIMERO_ULTIMO
				               + A.CRITICAS_ATIPICAS
				               + A.CRITICAS_FES
				               + A.CRITICAS_SALDO > 0
				                THEN 1
				
				            WHEN A.ADVERTENCIAS_NORMAL
				               + A.ADVERTENCIAS_PRIMERO_ULTIMO
				               + A.ALERTAS_HORA_00
				               + A.ADVERTENCIAS_FES
				               + A.FALTANTES_FES
				               + A.ADVERTENCIAS_SALDO
				               + A.FALTANTES_SALDO
				               + CASE
				                     WHEN M.INCLUIR_SLA_NORMAL = 1
				                         THEN A.FALTANTES_NORMAL
				                     ELSE 0
				                 END > 0
				                THEN 1
				
				            ELSE 0
				        END
				    ) AS AUD_REQUIERE_REVISION,
				
				    CASE
				        WHEN M.INCLUIR_SLA_NORMAL = 0
				            THEN 'NO APLICA'
				        WHEN A.CRITICAS_NORMAL
				           + A.CRITICAS_PRIMERO_ULTIMO
				           + A.CRITICAS_ATIPICAS > 0
				            THEN 'CRITICO'
				        WHEN A.FALTANTES_NORMAL > 0
				            THEN 'INCOMPLETO'
				        WHEN A.ADVERTENCIAS_NORMAL
				           + A.ADVERTENCIAS_PRIMERO_ULTIMO
				           + A.ALERTAS_HORA_00 > 0
				            THEN 'ADVERTENCIA'
				        ELSE 'OK'
				    END AS AUD_ESTADO_FLUJO_NORMAL,
				
				    CASE
				        WHEN M.ES_FES = 0
				            THEN 'NO APLICA'
				        WHEN A.CRITICAS_FES
				           + A.CRITICAS_ATIPICAS > 0
				            THEN 'CRITICO'
				        WHEN A.FALTANTES_FES > 0
				            THEN 'INCOMPLETO'
				        WHEN A.ADVERTENCIAS_FES
				           + A.ALERTAS_HORA_00 > 0
				            THEN 'ADVERTENCIA'
				        ELSE 'OK'
				    END AS AUD_ESTADO_FLUJO_FES,
				
				    CASE
				        WHEN M.ES_SALDO = 0
				            THEN 'NO APLICA'
				        WHEN A.CRITICAS_SALDO
				           + A.CRITICAS_ATIPICAS > 0
				            THEN 'CRITICO'
				        WHEN A.FALTANTES_SALDO > 0
				            THEN 'INCOMPLETO'
				        WHEN A.ADVERTENCIAS_SALDO
				           + A.ALERTAS_HORA_00 > 0
				            THEN 'ADVERTENCIA'
				        ELSE 'OK'
				    END AS AUD_ESTADO_FLUJO_SALDO,
				
				    CASE
				        WHEN A.CRITICAS_NORMAL
				           + A.CRITICAS_PRIMERO_ULTIMO
				           + A.CRITICAS_ATIPICAS
				           + A.CRITICAS_FES
				           + A.CRITICAS_SALDO > 0
				            THEN 'CRITICO'
				
				        WHEN A.ADVERTENCIAS_NORMAL
				           + A.ADVERTENCIAS_PRIMERO_ULTIMO
				           + A.ALERTAS_HORA_00
				           + A.ADVERTENCIAS_FES
				           + A.FALTANTES_FES
				           + A.ADVERTENCIAS_SALDO
				           + A.FALTANTES_SALDO
				           + CASE
				                 WHEN M.INCLUIR_SLA_NORMAL = 1
				                     THEN A.FALTANTES_NORMAL
				                 ELSE 0
				             END > 0
				            THEN 'REVISAR'
				
				        ELSE 'OK'
				    END AS AUD_ESTADO_GENERAL,
				
				    CASE
				        WHEN M.AUD_INC_TRP_MAS_30_DIAS_ANTES_PED = 1
				            THEN 'CRITICO: TRANSPORTE MAS DE 30 DIAS ANTES DEL PEDIDO'
				
				        WHEN M.AUD_INC_FAC_MAS_30_DIAS_ANTES_PED = 1
				            THEN 'CRITICO: FACTURA MAS DE 30 DIAS ANTES DEL PEDIDO'
				
				        WHEN M.AUD_INC_HITO_FECHA_FUTURA = 1
				            THEN 'CRITICO: HITO CON FECHA FUTURA'
				
				        WHEN M.AUD_INC_TRP_MAS_365_DIAS_DESPUES_PED = 1
				            THEN 'CRITICO: TRANSPORTE MAS DE 365 DIAS DESPUES DEL PEDIDO'
				
				        WHEN M.AUD_INC_FAC_MAS_365_DIAS_DESPUES_PED = 1
				            THEN 'CRITICO: FACTURA MAS DE 365 DIAS DESPUES DEL PEDIDO'
				
				        WHEN M.AUD_NO_FES_CON_METRICAS_FES = 1
				            THEN 'CRITICO: PEDIDO NO FES CON METRICAS FES'
				
				        WHEN M.AUD_NO_FES_CON_FECHAS_FES = 1
				            THEN 'CRITICO: PEDIDO NO FES CON FECHAS FES'
				
				        WHEN M.AUD_FES_PEDIDO_POST_ANTES_FACTURA = 1
				            THEN 'CRITICO FES: PEDIDO POSTERIOR EN FECHA ANTERIOR A FACTURA'
				
				        WHEN M.AUD_FES_ENTREGA_ANTES_PEDIDO_POST = 1
				            THEN 'CRITICO FES: ENTREGA POSTERIOR ANTES DEL PEDIDO POSTERIOR'
				
				        WHEN M.AUD_FES_MANIFIESTO_ANTES_ENTREGA = 1
				            THEN 'CRITICO FES: MANIFIESTO ANTES DE ENTREGA POSTERIOR'
				
				        WHEN M.AUD_FES_ULT_PEDIDO_ANTES_PRIMERO = 1
				            THEN 'CRITICO FES: ULTIMO PEDIDO POSTERIOR ANTES DEL PRIMERO'
				
				        WHEN M.AUD_FES_ULT_ENTREGA_ANTES_PRIMERA = 1
				            THEN 'CRITICO FES: ULTIMA ENTREGA POSTERIOR ANTES DE LA PRIMERA'
				
				        WHEN M.AUD_FES_ULT_MANIFIESTO_ANTES_PRIMERO = 1
				            THEN 'CRITICO FES: ULTIMO MANIFIESTO ANTES DEL PRIMERO'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.ENT_P_FECHA_HORA IS NOT NULL
				         AND M.PED_FECHA_HORA IS NOT NULL
				         AND CAST(M.ENT_P_FECHA_HORA AS DATE)
				             < CAST(M.PED_FECHA_HORA AS DATE)
				            THEN 'CRITICO: ENTREGA EN FECHA ANTERIOR AL PEDIDO'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.PIC_P_FECHA_HORA IS NOT NULL
				         AND M.ENT_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.PIC_P_FECHA_HORA AS DATE)
				             < CAST(M.ENT_P_FECHA_HORA AS DATE)
				            THEN 'CRITICO: PICKING EN FECHA ANTERIOR A ENTREGA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				         AND M.PIC_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				             < CAST(M.PIC_P_FECHA_HORA AS DATE)
				            THEN 'CRITICO: FACTURA EN FECHA ANTERIOR A PICKING'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.TRP_P_FECHA_HORA IS NOT NULL
				         AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				         AND CAST(M.TRP_P_FECHA_HORA AS DATE)
				             < CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				            THEN 'CRITICO: TRANSPORTE EN FECHA ANTERIOR A FACTURA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.TRP_U_FECHA_HORA IS NOT NULL
				         AND M.TRP_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				             < CAST(M.TRP_P_FECHA_HORA AS DATE)
				            THEN 'CRITICO: ULTIMO TRANSPORTE EN FECHA ANTERIOR AL PRIMERO'
				
				        WHEN M.ES_SALDO = 1
				         AND M.FAC_U_FECHA_HORA IS NOT NULL
				         AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				         AND CAST(M.FAC_U_FECHA_HORA AS DATE)
				             < CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				            THEN 'CRITICO SALDO: ULTIMA FACTURA EN FECHA ANTERIOR A LA PRIMERA'
				
				        WHEN M.ES_SALDO = 1
				         AND M.TRP_U_FECHA_HORA IS NOT NULL
				         AND M.TRP_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				             < CAST(M.TRP_P_FECHA_HORA AS DATE)
				            THEN 'CRITICO SALDO: ULTIMO TRANSPORTE EN FECHA ANTERIOR AL PRIMERO'
				
				        WHEN M.ES_FES = 1
				         AND M.FAC_P_FECHA_HORA_REAL IS NULL
				            THEN 'INCOMPLETO FES: SIN FACTURA ORIGINAL'
				
				        WHEN M.AUD_FES_SIN_FECHA_PEDIDO_POSTERIOR = 1
				            THEN 'INCOMPLETO FES: SIN FECHA DE PEDIDO POSTERIOR'
				
				        WHEN M.AUD_FES_SIN_ENTREGA_POSTERIOR = 1
				            THEN 'INCOMPLETO FES: SIN ENTREGA POSTERIOR'
				
				        WHEN M.AUD_FES_SIN_MANIFIESTO = 1
				            THEN 'INCOMPLETO FES: SIN MANIFIESTO'
				
				        WHEN M.ES_SALDO = 1
				         AND M.AUD_SALDO_SIN_FAC_P = 1
				            THEN 'INCOMPLETO SALDO: SIN PRIMERA FACTURA'
				
				        WHEN M.ES_SALDO = 1
				         AND M.AUD_SALDO_SIN_FAC_U = 1
				            THEN 'INCOMPLETO SALDO: SIN ULTIMA FACTURA'
				
				        WHEN M.ES_SALDO = 1
				         AND M.TRP_P_FECHA_HORA IS NULL
				            THEN 'INCOMPLETO SALDO: SIN PRIMER TRANSPORTE'
				
				        WHEN M.ES_SALDO = 1
				         AND M.AUD_SALDO_SIN_TRP_U = 1
				            THEN 'INCOMPLETO SALDO: SIN ULTIMO TRANSPORTE'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.PED_FECHA_HORA IS NULL
				            THEN 'INCOMPLETO NORMAL: SIN PEDIDO'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.ENT_P_FECHA_HORA IS NULL
				            THEN 'INCOMPLETO NORMAL: SIN ENTREGA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.PIC_P_FECHA_HORA IS NULL
				            THEN 'INCOMPLETO NORMAL: SIN PICKING'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.FAC_P_FECHA_HORA_REAL IS NULL
				            THEN 'INCOMPLETO NORMAL: SIN FACTURA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.TRP_P_FECHA_HORA IS NULL
				            THEN 'INCOMPLETO NORMAL: SIN TRANSPORTE'
				
				        WHEN M.AUD_FES_CICLO_MAYOR_60_DIAS = 1
				            THEN 'ADVERTENCIA FES: CICLO FACTURA A MANIFIESTO MAYOR A 60 DIAS'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.ENT_P_FECHA_HORA IS NOT NULL
				         AND M.PED_FECHA_HORA IS NOT NULL
				         AND CAST(M.ENT_P_FECHA_HORA AS DATE)
				             = CAST(M.PED_FECHA_HORA AS DATE)
				         AND M.ENT_P_FECHA_HORA < M.PED_FECHA_HORA
				            THEN 'ADVERTENCIA: ENTREGA ANTES DEL PEDIDO EN EL MISMO DIA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.PIC_P_FECHA_HORA IS NOT NULL
				         AND M.ENT_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.PIC_P_FECHA_HORA AS DATE)
				             = CAST(M.ENT_P_FECHA_HORA AS DATE)
				         AND M.PIC_P_FECHA_HORA < M.ENT_P_FECHA_HORA
				            THEN 'ADVERTENCIA: PICKING ANTES DE ENTREGA EN EL MISMO DIA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				         AND M.PIC_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				             = CAST(M.PIC_P_FECHA_HORA AS DATE)
				         AND M.FAC_P_FECHA_HORA_REAL < M.PIC_P_FECHA_HORA
				            THEN 'ADVERTENCIA: FACTURA ANTES DE PICKING EN EL MISMO DIA'
				
				        WHEN M.INCLUIR_SLA_NORMAL = 1
				         AND M.TRP_P_FECHA_HORA IS NOT NULL
				         AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				         AND CAST(M.TRP_P_FECHA_HORA AS DATE)
				             = CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				         AND M.TRP_P_FECHA_HORA < M.FAC_P_FECHA_HORA_REAL
				            THEN 'ADVERTENCIA: TRANSPORTE ANTES DE FACTURA EN EL MISMO DIA'
				
				        WHEN M.TRP_U_FECHA_HORA IS NOT NULL
				         AND M.TRP_P_FECHA_HORA IS NOT NULL
				         AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				             = CAST(M.TRP_P_FECHA_HORA AS DATE)
				         AND M.TRP_U_FECHA_HORA < M.TRP_P_FECHA_HORA
				            THEN 'ADVERTENCIA: ULTIMO TRANSPORTE ANTES DEL PRIMERO EN EL MISMO DIA'
				
				        WHEN A.ALERTAS_HORA_00 > 0
				            THEN 'ADVERTENCIA: HORA 00:00:00 EN UNO O MAS HITOS'
				
				        ELSE 'SIN INCONGRUENCIA'
				    END AS AUD_PRINCIPAL_INCONGRUENCIA
				
				INTO #FACT_NS_MASTER_AUD_V3
				
				FROM #FACT_NS_RAW_AUD_V3 AS M
				
				CROSS APPLY
				(
				    SELECT
				        CASE
				            WHEN M.ES_FES = 1
				             AND M.ES_SALDO = 1
				                THEN 8
				            WHEN M.ES_FES = 1
				                THEN 5
				            WHEN M.ES_SALDO = 1
				                THEN 5
				            ELSE 5
				        END AS HITOS_ESPERADOS,
				
				        CASE
				            WHEN M.ES_FES = 1
				             AND M.ES_SALDO = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_U_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_U_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_MANIFIESTO IS NOT NULL THEN 1 ELSE 0 END
				
				            WHEN M.ES_FES = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_MANIFIESTO IS NOT NULL THEN 1 ELSE 0 END
				
				            WHEN M.ES_SALDO = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_U_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_U_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				
				            ELSE
				                    CASE WHEN M.PED_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.ENT_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PIC_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NOT NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        END AS HITOS_PRESENTES,
				
				          CASE WHEN M.PDA_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.COM_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.CRD_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.GER_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.PAC_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.TSTTO_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				        + CASE WHEN M.CED_P_FECHA_HORA IS NOT NULL THEN 1 ELSE 0 END
				            AS HITOS_OPCIONALES_PRESENTES,
				
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.ENT_P_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PIC_P_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_P_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				            ELSE 0
				        END AS FALTANTES_NORMAL,
				
				        CASE
				            WHEN M.ES_FES = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_PEDIDO_POSTERIOR IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_ENTREGA_POSTERIOR IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.PRIMERA_FECHA_MANIFIESTO IS NULL THEN 1 ELSE 0 END
				            ELSE 0
				        END AS FALTANTES_FES,
				
				        CASE
				            WHEN M.ES_SALDO = 1
				                THEN
				                    CASE WHEN M.PED_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_P_FECHA_HORA_REAL IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.FAC_U_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_P_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				                  + CASE WHEN M.TRP_U_FECHA_HORA IS NULL THEN 1 ELSE 0 END
				            ELSE 0
				        END AS FALTANTES_SALDO,
				
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND M.PED_FECHA_HORA IS NOT NULL
				             AND CAST(M.ENT_P_FECHA_HORA AS DATE)
				                 < CAST(M.PED_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND CAST(M.PIC_P_FECHA_HORA AS DATE)
				                 < CAST(M.ENT_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				                 < CAST(M.PIC_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND CAST(M.TRP_P_FECHA_HORA AS DATE)
				                 < CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				                THEN 1
				            ELSE 0
				        END
				            AS CRITICAS_NORMAL,
				
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND M.PED_FECHA_HORA IS NOT NULL
				             AND CAST(M.ENT_P_FECHA_HORA AS DATE)
				                 = CAST(M.PED_FECHA_HORA AS DATE)
				             AND M.ENT_P_FECHA_HORA < M.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND CAST(M.PIC_P_FECHA_HORA AS DATE)
				                 = CAST(M.ENT_P_FECHA_HORA AS DATE)
				             AND M.PIC_P_FECHA_HORA < M.ENT_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				                 = CAST(M.PIC_P_FECHA_HORA AS DATE)
				             AND M.FAC_P_FECHA_HORA_REAL < M.PIC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND CAST(M.TRP_P_FECHA_HORA AS DATE)
				                 = CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				             AND M.TRP_P_FECHA_HORA < M.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.COM_P_FECHA_HORA IS NOT NULL
				             AND M.PED_FECHA_HORA IS NOT NULL
				             AND M.COM_P_FECHA_HORA < M.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.CRD_P_FECHA_HORA IS NOT NULL
				             AND M.PED_FECHA_HORA IS NOT NULL
				             AND M.CRD_P_FECHA_HORA < M.PED_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				            AS ADVERTENCIAS_NORMAL,
				
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND M.ENT_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.ENT_U_FECHA_HORA AS DATE)
				                 < CAST(M.ENT_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND M.PIC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.PIC_U_FECHA_HORA AS DATE)
				                 < CAST(M.PIC_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.FAC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_U_FECHA_HORA AS DATE)
				                 < CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.TRP_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				                 < CAST(M.TRP_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				            AS CRITICAS_PRIMERO_ULTIMO,
				
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.ENT_P_FECHA_HORA IS NOT NULL
				             AND M.ENT_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.ENT_U_FECHA_HORA AS DATE)
				                 = CAST(M.ENT_P_FECHA_HORA AS DATE)
				             AND M.ENT_U_FECHA_HORA < M.ENT_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.PIC_P_FECHA_HORA IS NOT NULL
				             AND M.PIC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.PIC_U_FECHA_HORA AS DATE)
				                 = CAST(M.PIC_P_FECHA_HORA AS DATE)
				             AND M.PIC_U_FECHA_HORA < M.PIC_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.FAC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_U_FECHA_HORA AS DATE)
				                 = CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				             AND M.FAC_U_FECHA_HORA < M.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.INCLUIR_SLA_NORMAL = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.TRP_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				                 = CAST(M.TRP_P_FECHA_HORA AS DATE)
				             AND M.TRP_U_FECHA_HORA < M.TRP_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				            AS ADVERTENCIAS_PRIMERO_ULTIMO,
				
				          CONVERT(INT, M.AUD_INC_FAC_MAS_30_DIAS_ANTES_PED)
				        + CONVERT(INT, M.AUD_INC_TRP_MAS_30_DIAS_ANTES_PED)
				        + CONVERT(INT, M.AUD_INC_FAC_MAS_365_DIAS_DESPUES_PED)
				        + CONVERT(INT, M.AUD_INC_TRP_MAS_365_DIAS_DESPUES_PED)
				        + CONVERT(INT, M.AUD_INC_HITO_FECHA_FUTURA)
				            AS CRITICAS_ATIPICAS,
				
				          CONVERT(INT, M.AUD_HORA_00_PED)
				        + CONVERT(INT, M.AUD_HORA_00_COM)
				        + CONVERT(INT, M.AUD_HORA_00_CRD)
				        + CONVERT(INT, M.AUD_HORA_00_ENT)
				        + CONVERT(INT, M.AUD_HORA_00_PIC)
				        + CONVERT(INT, M.AUD_HORA_00_PAC)
				        + CONVERT(INT, M.AUD_HORA_00_FAC)
				        + CONVERT(INT, M.AUD_HORA_00_TRP)
				        + CONVERT(INT, M.AUD_HORA_00_CED)
				            AS ALERTAS_HORA_00,
				
				          CONVERT(INT, M.AUD_FES_PEDIDO_POST_ANTES_FACTURA)
				        + CONVERT(INT, M.AUD_FES_ENTREGA_ANTES_PEDIDO_POST)
				        + CONVERT(INT, M.AUD_FES_MANIFIESTO_ANTES_ENTREGA)
				        + CONVERT(INT, M.AUD_FES_ULT_PEDIDO_ANTES_PRIMERO)
				        + CONVERT(INT, M.AUD_FES_ULT_ENTREGA_ANTES_PRIMERA)
				        + CONVERT(INT, M.AUD_FES_ULT_MANIFIESTO_ANTES_PRIMERO)
				        + CONVERT(INT, M.AUD_NO_FES_CON_FECHAS_FES)
				        + CONVERT(INT, M.AUD_NO_FES_CON_METRICAS_FES)
				            AS CRITICAS_FES,
				
				        CONVERT(INT, M.AUD_FES_CICLO_MAYOR_60_DIAS)
				            AS ADVERTENCIAS_FES,
				
				        CASE
				            WHEN M.ES_SALDO = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.FAC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_U_FECHA_HORA AS DATE)
				                 < CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.ES_SALDO = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.TRP_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				                 < CAST(M.TRP_P_FECHA_HORA AS DATE)
				                THEN 1
				            ELSE 0
				        END
				            AS CRITICAS_SALDO,
				
				        CASE
				            WHEN M.ES_SALDO = 1
				             AND M.FAC_P_FECHA_HORA_REAL IS NOT NULL
				             AND M.FAC_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.FAC_U_FECHA_HORA AS DATE)
				                 = CAST(M.FAC_P_FECHA_HORA_REAL AS DATE)
				             AND M.FAC_U_FECHA_HORA < M.FAC_P_FECHA_HORA_REAL
				                THEN 1
				            ELSE 0
				        END
				        +
				        CASE
				            WHEN M.ES_SALDO = 1
				             AND M.TRP_P_FECHA_HORA IS NOT NULL
				             AND M.TRP_U_FECHA_HORA IS NOT NULL
				             AND CAST(M.TRP_U_FECHA_HORA AS DATE)
				                 = CAST(M.TRP_P_FECHA_HORA AS DATE)
				             AND M.TRP_U_FECHA_HORA < M.TRP_P_FECHA_HORA
				                THEN 1
				            ELSE 0
				        END
				            AS ADVERTENCIAS_SALDO
				) AS A;
				
				DROP TABLE #FACT_NS_RAW_AUD_V3;
				
				SELECT *
				FROM #FACT_NS_MASTER_AUD_V3
				ORDER BY
				    TRY_CONVERT(BIGINT, PED_NUMERO_PEDIDO),
				    PED_NUMERO_PEDIDO;"
				            ]
				        ),
				
				    // Universo único V26: cartera Mayorista, canales 42 a 47.
				    // Incluye NORMAL, FES, SALDO y FES + SALDO.
				    // No exige que el pedido tenga factura.
				    FiltradoCanalesMayoristas =
				        Table.SelectRows(
				            Origen,
				            each
				                let
				                    Canal =
				                        Text.TrimStart(
				                            Text.Trim(
				                                Text.From(
				                                    [PED_CANAL_CODIGO]
				                                )
				                            ),
				                            "0"
				                        )
				                in
				                    List.Contains(
				                        {
				                            "42",
				                            "43",
				                            "44",
				                            "45",
				                            "46",
				                            "47"
				                        },
				                        Canal
				                    )
				        ),
				    #"Filas ordenadas" = Table.Sort(FiltradoCanalesMayoristas,{{"PED_FECHA_HORA", Order.Descending}}),
				    VBAK_APPEND_ACTIVO_LOCAL = true,
				
				    FnNormalizaPedidoVBAK = (Valor as any) as nullable text =>
				        let
				            Texto = try Text.Trim(Text.From(Valor)) otherwise null,
				            Numero = if Texto = null or Texto = "" then null else try Int64.FromText(Texto) otherwise null
				        in
				            if Texto = null or Texto = "" then null
				            else if Numero <> null then Text.From(Numero)
				            else let SinCeros = Text.TrimStart(Texto, "0") in if SinCeros = "" then "0" else SinCeros,
				
				    FnDHAppendVBAK = (Inicio as any, Fin as any) as nullable number =>
				        let
				            I = try Date.From(Inicio) otherwise null,
				            F = try Date.From(Fin) otherwise null,
				            Feriados = List.Buffer(List.Transform(Dim_Feriados_Chile[Fecha], each Date.From(_))),
				            Fechas = if I = null or F = null or F < I then {} else if F = I then {} else List.Dates(Date.AddDays(I, 1), Duration.Days(F - I), #duration(1, 0, 0, 0)),
				            Habiles = List.Select(Fechas, each Date.DayOfWeek(_, Day.Monday) < 5 and not List.Contains(Feriados, _))
				        in
				            if I = null or F = null or F < I then null else List.Count(Habiles),
				
				    MasterBaseVBAK = #"Filas ordenadas",
				    MasterKeysVBAK =
				        Table.Distinct(
				            Table.TransformColumns(
				                Table.SelectColumns(MasterBaseVBAK, {"PED_NUMERO_PEDIDO"}),
				                {{"PED_NUMERO_PEDIDO", each FnNormalizaPedidoVBAK(_), type nullable text}}
				            ),
				            {"PED_NUMERO_PEDIDO"}
				        ),
				
				    VBAKSqlOrigen =
				        Sql.Database(
				            "128.1.3.21",
				            "DMF_VTA_PRD",
				            [
				                Query =
				                    Text.Combine(
				                        {
				                            "SET NOCOUNT ON;",
				                            "SELECT",
				                            "    CONVERT(VARCHAR(20), V.VBELN) AS PED_NUMERO_PEDIDO,",
				                            "    LTRIM(RTRIM(CONVERT(VARCHAR(30), V.KUNNR))) AS PED_CODIGO_CLIENTE,",
				                            "    RIGHT('00' + LTRIM(RTRIM(CONVERT(VARCHAR(10), V.VTWEG))), 2) AS PED_CANAL_CODIGO,",
				                            "    CAST(NULL AS VARCHAR(20)) AS PED_CONDICION_EXPEDICION_CODIGO,",
				                            "    TRY_CONVERT(DECIMAL(18,2), V.NETWR) AS PED_VALOR_NETO,",
				                            "    NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(10), V.WAERK))), '') AS PED_MONEDA,",
				                            "    NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(20), V.LIFSK))), '') AS PED_BLOQUEO_ENTREGA,",
				                            "    CAST(NULL AS VARCHAR(20)) AS PED_ESTADO_CREDITO,",
				                            "    NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(100), V.BSTNK))), '') AS PED_ORDEN_COMPRA_CLIENTE,",
				                            "    CAST(NULL AS VARCHAR(200)) AS PED_CIUDAD,",
				                            "    NULLIF(LTRIM(RTRIM(CONVERT(VARCHAR(30), K.REGIO))), '') AS PED_REGION,",
				                            "    CAST(COALESCE(",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT), 112),",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT), 103),",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT))",
				                            "    ) AS DATETIME2(0)) AS PED_FECHA_HORA,",
				                            "    CONVERT(BIT, CASE WHEN EXISTS (",
				                            "        SELECT 1",
				                            "        FROM dbo.VBFA_SAP AS F",
				                            "        WHERE F.VBTYP_V = 'C'",
				                            "          AND F.VBTYP_N = 'C'",
				                            "          AND TRY_CONVERT(BIGINT, F.VBELV) = TRY_CONVERT(BIGINT, V.VBELN)",
				                            "    ) THEN 1 ELSE 0 END) AS ES_FES_VBFA",
				                            "FROM dbo.VBAK_SAP AS V",
				                            "LEFT JOIN dbo.KNA1_SAP AS K",
				                            "    ON TRY_CONVERT(BIGINT, K.KUNNR) = TRY_CONVERT(BIGINT, V.KUNNR)",
				                            "WHERE V.AUART IN ('ZEDI','ZMAY','ZMAN','ZPDA','ZVGF','ZREL','ZVGM','ZTAN','TAN')",
				                            "  AND COALESCE(",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT), 112),",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT), 103),",
				                            "        TRY_CONVERT(DATE, CONVERT(VARCHAR(30), V.ERDAT))",
				                            "      ) >= DATEADD(MONTH, -3, CAST(GETDATE() AS DATE));"
				                        },
				                        "#(lf)"
				                    )
				            ]
				        ),
				
				    VBAKSqlTipos =
				        Table.TransformColumnTypes(
				            VBAKSqlOrigen,
				            {
				                {"PED_NUMERO_PEDIDO", type text},
				                {"PED_CODIGO_CLIENTE", type text},
				                {"PED_CANAL_CODIGO", type text},
				                {"PED_CONDICION_EXPEDICION_CODIGO", type text},
				                {"PED_VALOR_NETO", type number},
				                {"PED_MONEDA", type text},
				                {"PED_BLOQUEO_ENTREGA", type text},
				                {"PED_ESTADO_CREDITO", type text},
				                {"PED_ORDEN_COMPRA_CLIENTE", type text},
				                {"PED_CIUDAD", type text},
				                {"PED_REGION", type text},
				                {"PED_FECHA_HORA", type datetime},
				                {"ES_FES_VBFA", type logical}
				            }
				        ),
				
				    VBAKSqlKey =
				        Table.TransformColumns(
				            VBAKSqlTipos,
				            {{"PED_NUMERO_PEDIDO", each FnNormalizaPedidoVBAK(_), type nullable text}}
				        ),
				
				    VBAKSqlUnico = Table.Distinct(Table.SelectRows(VBAKSqlKey, each [PED_NUMERO_PEDIDO] <> null), {"PED_NUMERO_PEDIDO"}),
				
				    VBAKOperacionBase =
				        Table.SelectColumns(
				            Pedidos_Normal_VBAK,
				            {"VBELN", "fecha_pedido", "fecha_entrega", "fecha_contabiliza", "fecha_factura", "fecha_fes", "fecha_salida"},
				            MissingField.UseNull
				        ),
				
				    VBAKOperacionKey =
				        Table.AddColumn(
				            VBAKOperacionBase,
				            "PED_NUMERO_PEDIDO",
				            each FnNormalizaPedidoVBAK([VBELN]),
				            type nullable text
				        ),
				
				    VBAKOperacionUnica =
				        Table.Group(
				            Table.SelectRows(VBAKOperacionKey, each [PED_NUMERO_PEDIDO] <> null),
				            {"PED_NUMERO_PEDIDO"},
				            {
				                {"VBAK_FECHA_ENTREGA", each try List.Min(List.RemoveNulls([fecha_entrega])) otherwise null, type nullable date},
				                {"VBAK_FECHA_CONTABILIZA", each try List.Min(List.RemoveNulls([fecha_contabiliza])) otherwise null, type nullable date},
				                {"VBAK_FECHA_FACTURA", each try List.Min(List.RemoveNulls([fecha_factura])) otherwise null, type nullable date},
				                {"VBAK_FECHA_FES", each try List.Min(List.RemoveNulls([fecha_fes])) otherwise null, type nullable date},
				                {"VBAK_FECHA_SALIDA", each try List.Max(List.RemoveNulls([fecha_salida])) otherwise null, type nullable datetime}
				            }
				        ),
				
				    VBAKConOperacionJoin =
				        Table.NestedJoin(
				            VBAKSqlUnico,
				            {"PED_NUMERO_PEDIDO"},
				            VBAKOperacionUnica,
				            {"PED_NUMERO_PEDIDO"},
				            "OPERACION",
				            JoinKind.LeftOuter
				        ),
				
				    VBAKConOperacion =
				        Table.ExpandTableColumn(
				            VBAKConOperacionJoin,
				            "OPERACION",
				            {"VBAK_FECHA_ENTREGA", "VBAK_FECHA_CONTABILIZA", "VBAK_FECHA_FACTURA", "VBAK_FECHA_FES", "VBAK_FECHA_SALIDA"},
				            {"VBAK_FECHA_ENTREGA", "VBAK_FECHA_CONTABILIZA", "VBAK_FECHA_FACTURA", "VBAK_FECHA_FES", "VBAK_FECHA_SALIDA"}
				        ),
				
				    VBAKFaltantes =
				        Table.NestedJoin(
				            VBAKConOperacion,
				            {"PED_NUMERO_PEDIDO"},
				            MasterKeysVBAK,
				            {"PED_NUMERO_PEDIDO"},
				            "MASTER",
				            JoinKind.LeftAnti
				        ),
				
				    VBAKElegibles =
				        Table.SelectRows(
				            VBAKFaltantes,
				            each
				                [PED_NUMERO_PEDIDO] <> null
				                and List.Contains({"42", "43", "44", "45", "46", "47"}, [PED_CANAL_CODIGO])
				                and [PED_CODIGO_CLIENTE] <> null and Text.Trim([PED_CODIGO_CLIENTE]) <> ""
				                and [PED_REGION] <> null and Text.Trim([PED_REGION]) <> ""
				                and [PED_FECHA_HORA] <> null
				                and [ES_FES_VBFA] <> true
				                and [VBAK_FECHA_FES] = null
				                and ([VBAK_FECHA_ENTREGA] = null or Date.From([VBAK_FECHA_ENTREGA]) >= Date.From([PED_FECHA_HORA]))
				                and ([VBAK_FECHA_FACTURA] = null or Date.From([VBAK_FECHA_FACTURA]) >= Date.From([PED_FECHA_HORA]))
				                and ([VBAK_FECHA_SALIDA] = null or ([VBAK_FECHA_FACTURA] <> null and Date.From([VBAK_FECHA_SALIDA]) >= Date.From([VBAK_FECHA_FACTURA])))
				        ),
				
				    VBAKAddResponsable = Table.AddColumn(VBAKElegibles, "PED_RESPONSABLE", each null, type nullable text),
				    VBAKAddCentro = Table.AddColumn(VBAKAddResponsable, "PED_CENTRO", each null, type nullable text),
				    VBAKAddCanal = Table.AddColumn(VBAKAddCentro, "PED_CANAL", each null, type nullable text),
				    VBAKAddCondicion = Table.AddColumn(VBAKAddCanal, "PED_CONDICION_EXPEDICION", each null, type nullable text),
				    VBAKAddServicio = Table.AddColumn(VBAKAddCondicion, "SERV_TIPO_SERVICIO", each null, type nullable text),
				    VBAKAddServicioPlan = Table.AddColumn(VBAKAddServicio, "SERV_TIPO_SERVICIO_PLANIFICADO", each null, type nullable text),
				    VBAKAddOTIF = Table.AddColumn(VBAKAddServicioPlan, "OTIF_ESTADO_PEDIDO", each if [VBAK_FECHA_SALIDA] = null then "ABIERTO VBAK" else "CERRADO VBAK", type text),
				    VBAKAddEstado = Table.AddColumn(VBAKAddOTIF, "PED_TEXTO_ESTADO", each "VBAK SIN ZART", type text),
				    VBAKAddFES = Table.AddColumn(VBAKAddEstado, "ES_FES", each false, type logical),
				    VBAKAddSaldo = Table.AddColumn(VBAKAddFES, "ES_SALDO", each false, type logical),
				    VBAKAddReglaFES = Table.AddColumn(VBAKAddSaldo, "REGLA_CLASIFICACION_FES", each "NO FES; VALIDADO VBFA C-C", type text),
				    VBAKAddReglaSaldo = Table.AddColumn(VBAKAddReglaFES, "REGLA_CLASIFICACION_SALDO", each "NO SALDO; SIN EVIDENCIA DE FACTURAS DIFERIDAS", type text),
				    VBAKAddSegmento = Table.AddColumn(VBAKAddReglaSaldo, "SEGMENTO_ANALISIS", each "FLUJO NORMAL", type text),
				    VBAKAddIncluir = Table.AddColumn(VBAKAddSegmento, "INCLUIR_SLA_NORMAL", each true, type logical),
				    VBAKAddEntregaP = Table.AddColumn(VBAKAddIncluir, "ENT_P_FECHA_HORA", each if [VBAK_FECHA_ENTREGA] = null then null else DateTime.From([VBAK_FECHA_ENTREGA]), type nullable datetime),
				    VBAKAddEntregaU = Table.AddColumn(VBAKAddEntregaP, "ENT_U_FECHA_HORA", each [ENT_P_FECHA_HORA], type nullable datetime),
				    VBAKAddFacturaP = Table.AddColumn(VBAKAddEntregaU, "FAC_P_FECHA_HORA_REAL", each if [VBAK_FECHA_FACTURA] = null then null else DateTime.From([VBAK_FECHA_FACTURA]), type nullable datetime),
				    VBAKAddFacturaU = Table.AddColumn(VBAKAddFacturaP, "FAC_U_FECHA_HORA", each [FAC_P_FECHA_HORA_REAL], type nullable datetime),
				    VBAKAddTransporteP = Table.AddColumn(VBAKAddFacturaU, "TRP_P_FECHA_HORA", each if [VBAK_FECHA_SALIDA] = null then null else DateTime.From([VBAK_FECHA_SALIDA]), type nullable datetime),
				    VBAKAddTransporteU = Table.AddColumn(VBAKAddTransporteP, "TRP_U_FECHA_HORA", each [TRP_P_FECHA_HORA], type nullable datetime),
				    VBAKAddFacturaAjustada = Table.AddColumn(VBAKAddTransporteU, "FAC_FECHA_OPERATIVA_AJUSTADA", each [FAC_P_FECHA_HORA_REAL], type nullable datetime),
				    VBAKAddDHLead = Table.AddColumn(VBAKAddFacturaAjustada, "DH_LEAD_NORMAL", each FnDHAppendVBAK([PED_FECHA_HORA], [TRP_U_FECHA_HORA]), Int64.Type),
				    VBAKAddDHEntrega = Table.AddColumn(VBAKAddDHLead, "DH_ENTREGA_COMPLETA_100", each [DH_LEAD_NORMAL], Int64.Type),
				    VBAKAddDHDespacho = Table.AddColumn(VBAKAddDHEntrega, "DH_DESPACHO", each FnDHAppendVBAK([FAC_P_FECHA_HORA_REAL], [TRP_U_FECHA_HORA]), Int64.Type),
				    VBAKAddDHFacturaUltima = Table.AddColumn(VBAKAddDHDespacho, "DH_PRIMERA_FACTURA_A_ULTIMO_DESPACHO", each [DH_DESPACHO], Int64.Type),
				    VBAKAddDHBrecha = Table.AddColumn(VBAKAddDHFacturaUltima, "DH_BRECHA_PRIMER_ULTIMO_DESPACHO", each if [TRP_U_FECHA_HORA] = null then null else 0, Int64.Type),
				    VBAKAddMes = Table.AddColumn(VBAKAddDHBrecha, "MES_CREACION", each Date.ToText(Date.From([PED_FECHA_HORA]), "yyyy-MM"), type text),
				    VBAKAddDia = Table.AddColumn(VBAKAddMes, "DIA_MES_CREACION", each Date.Day(Date.From([PED_FECHA_HORA])), Int64.Type),
				    VBAKAddTramo = Table.AddColumn(VBAKAddDia, "TRAMO_MES_CALENDARIO", each let D = [DIA_MES_CREACION] in if D <= 7 then "01-07" else if D <= 14 then "08-14" else if D <= 21 then "15-21" else "22-FIN", type text),
				    VBAKAddAudEstado = Table.AddColumn(VBAKAddTramo, "AUD_ESTADO_GENERAL", each "REVISAR", type text),
				    VBAKAddAudNormal = Table.AddColumn(VBAKAddAudEstado, "AUD_ESTADO_FLUJO_NORMAL", each "REVISAR", type text),
				    VBAKAddAudFES = Table.AddColumn(VBAKAddAudNormal, "AUD_ESTADO_FLUJO_FES", each "NO APLICA", type text),
				    VBAKAddAudSaldo = Table.AddColumn(VBAKAddAudFES, "AUD_ESTADO_FLUJO_SALDO", each "NO APLICA", type text),
				    VBAKAddAudPrincipal = Table.AddColumn(VBAKAddAudSaldo, "AUD_PRINCIPAL_INCONGRUENCIA", each "VBAK SIN ZART; VALIDAR TRAZABILIDAD", type text),
				    VBAKAddAudRevision = Table.AddColumn(VBAKAddAudPrincipal, "AUD_REQUIERE_REVISION", each true, type logical),
				    VBAKAddAudCrit = Table.AddColumn(VBAKAddAudRevision, "AUD_TOTAL_CRITICAS", each 0, Int64.Type),
				    VBAKAddAudAdv = Table.AddColumn(VBAKAddAudCrit, "AUD_TOTAL_ADVERTENCIAS", each 1, Int64.Type),
				    VBAKAddAudTotal = Table.AddColumn(VBAKAddAudAdv, "AUD_TOTAL_INCONGRUENCIAS", each 1, Int64.Type),
				
				    ColumnasMasterVBAK = Table.ColumnNames(MasterBaseVBAK),
				    VBAKProyectadoMaster = Table.SelectColumns(VBAKAddAudTotal, ColumnasMasterVBAK, MissingField.UseNull),
				    VBAKTipadoMaster = Value.ReplaceType(VBAKProyectadoMaster, Value.Type(MasterBaseVBAK)),
				    MasterConVBAK =
				        Value.ReplaceType(
				            Table.Sort(
				                Table.Combine({MasterBaseVBAK, VBAKTipadoMaster}, ColumnasMasterVBAK),
				                {{"PED_FECHA_HORA", Order.Descending}}
				            ),
				            Value.Type(MasterBaseVBAK)
				        ),
				    ResultadoVBAK = if VBAK_APPEND_ACTIVO_LOCAL then MasterConVBAK else MasterBaseVBAK
				in
				    ResultadoVBAK

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

