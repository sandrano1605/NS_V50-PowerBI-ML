/// Cola operacional de pedidos pendientes. Una fila por pedido, ordenada por prioridad de intervención.
table ML_Pedidos_Pendientes_Priorizados
	lineageTag: 6db52ee0-3866-4d9b-b18f-f2f2e7d000ea

	measure 'Pendientes Total' = COUNTROWS(ML_Pedidos_Pendientes_Priorizados)
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\Volumen
		lineageTag: 2b352339-7153-4517-a508-454ed5b584d6

	measure 'Pendientes Críticos' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Priorizados), ML_Pedidos_Pendientes_Priorizados[PRIORIDAD_OPERATIVA] = "CRÍTICA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\Prioridad
		lineageTag: d84c777a-6fdb-4b74-84d2-4ec7972918a8

	measure 'Pendientes Alta Prioridad' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Priorizados), ML_Pedidos_Pendientes_Priorizados[PRIORIDAD_OPERATIVA] = "ALTA")
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\Prioridad
		lineageTag: 821a9ebb-19ec-4642-918f-cad1c81d62b5

	measure 'Pendientes Intervenir Hoy' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Priorizados), ML_Pedidos_Pendientes_Priorizados[ESTADO_ACCION] IN {"INTERVENIR HOY", "REVISAR HOY"})
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\Prioridad
		lineageTag: c8ba6dec-8afd-4247-84be-1a176580fc0f

	measure 'Pendientes Fuera SLA' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Priorizados), ML_Pedidos_Pendientes_Priorizados[DIAS_ACTUALES_DH] > 5)
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\SLA
		lineageTag: 0b4aa273-5fe6-42b3-a666-6190b8ab380c

	measure 'Valor Pendiente' = SUM(ML_Pedidos_Pendientes_Priorizados[VALOR_NETO])
		formatString: "CLP $" #,0;-"CLP $" #,0;"CLP $" 0
		displayFolder: 05. Pedidos Pendientes\Impacto
		lineageTag: 0962bb02-f59f-48a4-9197-dd419fb51842

	measure 'Valor Crítico y Alto' = CALCULATE(SUM(ML_Pedidos_Pendientes_Priorizados[VALOR_NETO]), ML_Pedidos_Pendientes_Priorizados[PRIORIDAD_OPERATIVA] IN {"CRÍTICA", "ALTA"})
		formatString: "CLP $" #,0;-"CLP $" #,0;"CLP $" 0
		displayFolder: 05. Pedidos Pendientes\Impacto
		lineageTag: 047f4e95-4865-46d1-9c7b-a78dbf4000ee

	measure 'Riesgo ML Promedio Pendientes' = AVERAGE(ML_Pedidos_Pendientes_Priorizados[PROB_ML_ATRASO_NORM])
		formatString: 0.0%
		displayFolder: 05. Pedidos Pendientes\Riesgo
		lineageTag: 3034a659-09f0-4df0-b354-9a02bbcbd404

	measure 'Días Actuales Promedio Pendientes' = AVERAGE(ML_Pedidos_Pendientes_Priorizados[DIAS_ACTUALES_DH])
		formatString: 0.0
		displayFolder: 05. Pedidos Pendientes\SLA
		lineageTag: 393bbc7d-9a64-4a10-8afb-6666865a0ca4

	measure 'Pendientes Sin Antecedentes' = CALCULATE(COUNTROWS(ML_Pedidos_Pendientes_Priorizados), ML_Pedidos_Pendientes_Priorizados[HIST_SOPORTE_MIN] = 0)
		formatString: #,0
		displayFolder: 05. Pedidos Pendientes\Calidad
		lineageTag: e1cd17fe-32ea-4696-a893-4cb77a97fbb9

	column RANK_PRIORIDAD
		dataType: int64
		formatString: 0
		lineageTag: 538b3751-0af6-4307-bd36-4fc711b214fc
		summarizeBy: none
		sourceColumn: RANK_PRIORIDAD

