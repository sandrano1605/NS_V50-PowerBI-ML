	column USO_DH_PREDICHO
		dataType: string
		lineageTag: 290f35bb-dd64-4bb6-9496-c8b445d9fd84
		summarizeBy: none
		sourceColumn: USO_DH_PREDICHO

	partition ML_Pedidos_Pendientes_Priorizados = m
		mode: import
		source =
				let
				    Campos = {"PED_NUMERO_PEDIDO", "PED_FECHA", "CLIENTE", "VENDEDOR", "PED_CANAL", "PED_REGION", "ZONA", "VALOR_NETO", "ESTADO_ACTUAL", "HITO_ACTUAL", "RESPONSABLE_AREA", "DIAS_ACTUALES_DH", "DIAS_EN_ESTADO_DH", "PROB_ML_ATRASO", "SLA_CONSUMIDO_PCT", "DH_PREDICHO_ML", "DIAS_RESTANTES_PREDICHOS", "PREDICCION_SLA", "FACTOR_PRINCIPAL", "FACTOR_HISTORICO", "ES_FIN_MES", "ES_PENDIENTE"},
				    Base = Table.SelectRows(Table.SelectColumns(Resultado, Campos, MissingField.UseNull), each [ES_PENDIENTE] = true),
				    HistBase = Table.SelectColumns(ML_Historicos_Sin_Fuga, {"PED_NUMERO_PEDIDO", "HIST_CLIENTE_RIESGO", "HIST_VENDEDOR_RIESGO", "HIST_CANAL_RIESGO", "HIST_SOPORTE_MIN"}, MissingField.UseNull),
				    JoinHist = Table.NestedJoin(Base, {"PED_NUMERO_PEDIDO"}, HistBase, {"PED_NUMERO_PEDIDO"}, "Hist", JoinKind.LeftOuter),
				    ExpandHist = Table.ExpandTableColumn(JoinHist, "Hist", {"HIST_CLIENTE_RIESGO", "HIST_VENDEDOR_RIESGO", "HIST_CANAL_RIESGO", "HIST_SOPORTE_MIN"}, {"HIST_CLIENTE_RIESGO", "HIST_VENDEDOR_RIESGO", "HIST_CANAL_RIESGO", "HIST_SOPORTE_MIN"}),
				    Numeros = Table.TransformColumns(ExpandHist, {
				        {"VALOR_NETO", each try Number.From(_) otherwise 0, type number},
				        {"DIAS_ACTUALES_DH", each try Number.From(_) otherwise 0, type number},
				        {"DIAS_EN_ESTADO_DH", each try Number.From(_) otherwise 0, type number},
				        {"PROB_ML_ATRASO", each try Number.From(_) otherwise null, type nullable number},
				        {"SLA_CONSUMIDO_PCT", each try Number.From(_) otherwise null, type nullable number},
				        {"DH_PREDICHO_ML", each try Number.From(_) otherwise null, type nullable number},
				        {"DIAS_RESTANTES_PREDICHOS", each try Number.From(_) otherwise null, type nullable number},
				        {"HIST_CLIENTE_RIESGO", each try Number.From(_) otherwise 0.15, type number},
				        {"HIST_VENDEDOR_RIESGO", each try Number.From(_) otherwise 0.15, type number},
				        {"HIST_CANAL_RIESGO", each try Number.From(_) otherwise 0.15, type number},
				        {"HIST_SOPORTE_MIN", each try Int64.From(_) otherwise 0, Int64.Type}
				    }),
				    ValoresRaw = List.RemoveNulls(List.Transform(Resultado[PROB_ML_ATRASO], each try Number.From(_) otherwise null)),
				    MaxAbsRaw = if List.Count(ValoresRaw) = 0 then null else List.Max(List.Transform(ValoresRaw, each Number.Abs(_))),
				    EscalaGlobal = if MaxAbsRaw = null or MaxAbsRaw <= 1 then 1 else Number.Power(10, Number.RoundUp(Number.Log10(MaxAbsRaw))),
				    ConProb = Table.AddColumn(Numeros, "PROB_ML_ATRASO_NORM", each let p = [PROB_ML_ATRASO], v = if p = null then null else p / EscalaGlobal in if v = null or v < 0 or v > 1 then null else v, type nullable number),
				    ConEtiqueta = Table.AddColumn(ConProb, "RIESGO_ML_ETIQUETA", each if [DIAS_ACTUALES_DH] > 5 then "ATRASADO" else if [PROB_ML_ATRASO_NORM] = null then "SIN SCORE" else if [PROB_ML_ATRASO_NORM] >= 0.20 then "ALTO" else if [PROB_ML_ATRASO_NORM] >= 0.10 then "MEDIO" else "BAJO", type text),
				    ConHistMax = Table.AddColumn(ConEtiqueta, "RIESGO_HISTORICO_MAX", each let v = List.RemoveNulls({[HIST_CLIENTE_RIESGO], [HIST_VENDEDOR_RIESGO], [HIST_CANAL_RIESGO]}) in if List.Count(v) = 0 then 0.15 else List.Max(v), type number),
				    ConPSLA = Table.AddColumn(ConHistMax, "PUNTOS_SLA", each if [DIAS_ACTUALES_DH] > 5 then 40 else if [DIAS_ACTUALES_DH] >= 4 then 30 else if [DIAS_ACTUALES_DH] >= 3 then 20 else if [DIAS_ACTUALES_DH] >= 2 then 10 else 0, Int64.Type),
				    ConPML = Table.AddColumn(ConPSLA, "PUNTOS_RIESGO_ML", each if [PROB_ML_ATRASO_NORM] = null then 0 else if [PROB_ML_ATRASO_NORM] >= 0.20 then 25 else if [PROB_ML_ATRASO_NORM] >= 0.10 then 15 else 5, Int64.Type),
				    ConPPerm = Table.AddColumn(ConPML, "PUNTOS_PERMANENCIA", each if [DIAS_EN_ESTADO_DH] >= 2 then 15 else if [DIAS_EN_ESTADO_DH] >= 1 then 8 else 0, Int64.Type),
				    ConPValor = Table.AddColumn(ConPPerm, "PUNTOS_VALOR", each if [VALOR_NETO] >= 5000000 then 10 else if [VALOR_NETO] >= 2600000 then 6 else 0, Int64.Type),
				    ConPHist = Table.AddColumn(ConPValor, "PUNTOS_HISTORICO", each if [HIST_SOPORTE_MIN] <= 0 then 0 else if [RIESGO_HISTORICO_MAX] >= 0.20 then 10 else if [RIESGO_HISTORICO_MAX] >= 0.15 then 5 else 0, Int64.Type),
				    ConPFinMes = Table.AddColumn(ConPHist, "PUNTOS_FIN_MES", each let t = Text.Upper(Text.Trim(if [ES_FIN_MES] = null then "" else Text.From([ES_FIN_MES]))) in if List.Contains({"TRUE", "1", "SI", "SÍ", "YES", "ULTIMOS 7 DH", "ÚLTIMOS 7 DH"}, t) then 5 else 0, Int64.Type),
				    ConScore = Table.AddColumn(ConPFinMes, "PRIORIDAD_OPERATIVA_SCORE", each let total = [PUNTOS_SLA] + [PUNTOS_RIESGO_ML] + [PUNTOS_PERMANENCIA] + [PUNTOS_VALOR] + [PUNTOS_HISTORICO] + [PUNTOS_FIN_MES] in Int64.From(if total > 100 then 100 else total), Int64.Type),
				    ConPrioridad = Table.AddColumn(ConScore, "PRIORIDAD_OPERATIVA", each if [DIAS_ACTUALES_DH] > 5 or [PRIORIDAD_OPERATIVA_SCORE] >= 70 then "CRÍTICA" else if [PRIORIDAD_OPERATIVA_SCORE] >= 50 then "ALTA" else if [PRIORIDAD_OPERATIVA_SCORE] >= 30 then "MEDIA" else "BAJA", type text),
				    ConOrden = Table.AddColumn(ConPrioridad, "ORDEN_PRIORIDAD", each if [PRIORIDAD_OPERATIVA] = "CRÍTICA" then 1 else if [PRIORIDAD_OPERATIVA] = "ALTA" then 2 else if [PRIORIDAD_OPERATIVA] = "MEDIA" then 3 else 4, Int64.Type),
				    ConListaCriterios = Table.AddColumn(ConOrden, "_LISTA_CRITERIOS", each List.RemoveNulls({if [PUNTOS_SLA] >= 40 then "SLA vencido" else if [PUNTOS_SLA] > 0 then "SLA próximo" else null, if [PUNTOS_RIESGO_ML] >= 25 then "Riesgo ML alto" else if [PUNTOS_RIESGO_ML] >= 15 then "Riesgo ML medio" else null, if [PUNTOS_PERMANENCIA] > 0 then "Permanencia en hito" else null, if [PUNTOS_VALOR] > 0 then "Valor relevante" else null, if [PUNTOS_HISTORICO] > 0 then "Patrón histórico" else null, if [PUNTOS_FIN_MES] > 0 then "Fin de mes" else null})),
				    ConCantCriterios = Table.AddColumn(ConListaCriterios, "CANT_CRITERIOS_ACTIVOS", each List.Count([_LISTA_CRITERIOS]), Int64.Type),
				    ConCriterios = Table.AddColumn(ConCantCriterios, "CRITERIOS_ACTIVOS", each if List.Count([_LISTA_CRITERIOS]) = 0 then "Sin criterio crítico" else Text.Combine([_LISTA_CRITERIOS], " · "), type text),
				    ConFoco = Table.AddColumn(ConCriterios, "FOCO_INTERVENCION", each let h = Text.Upper(Text.Trim(if [HITO_ACTUAL] = null then "" else Text.From([HITO_ACTUAL]))), r = Text.Trim(if [RESPONSABLE_AREA] = null then "" else Text.From([RESPONSABLE_AREA])) in if Text.Contains(h, "CRED") then "CRÉDITO Y COBRANZAS" else if Text.Contains(h, "VEND") or Text.Contains(h, "COMERCIAL") or Text.Contains(h, "SAC") then "COMERCIAL / SAC" else if Text.Contains(h, "PICK") or Text.Contains(h, "OPER") or Text.Contains(h, "ENTREGA") then "OPERACIÓN INTERNA" else if Text.Contains(h, "FACT") or Text.Contains(h, "DESP") or Text.Contains(h, "MANIF") then "FACTURA / DESPACHO" else if r <> "" then Text.Upper(r) else "CONTROL DE GESTIÓN", type text),
				    ConAccion = Table.AddColumn(ConFoco, "ACCION_OPERATIVA", each if [DIAS_ACTUALES_DH] > 5 then "Escalar hoy, confirmar bloqueo y fecha de liberación" else if [DIAS_EN_ESTADO_DH] >= 2 then "Destrabar hito actual y asignar responsable" else if [PROB_ML_ATRASO_NORM] <> null and [PROB_ML_ATRASO_NORM] >= 0.20 then "Revisar causa probable antes de consumir SLA" else if [RIESGO_HISTORICO_MAX] >= 0.20 and [HIST_SOPORTE_MIN] > 0 then "Revisar recurrencia de cliente, vendedor y canal" else if [VALOR_NETO] >= 5000000 then "Seguimiento preventivo por exposición económica" else "Monitorear avance y próxima actualización", type text),
				    ConEstadoAccion = Table.AddColumn(ConAccion, "ESTADO_ACCION", each if [PRIORIDAD_OPERATIVA] = "CRÍTICA" then "INTERVENIR HOY" else if [PRIORIDAD_OPERATIVA] = "ALTA" then "REVISAR HOY" else if [PRIORIDAD_OPERATIVA] = "MEDIA" then "SEGUIMIENTO" else "MONITOREAR", type text),
				    ConUsoDias = Table.AddColumn(ConEstadoAccion, "USO_DH_PREDICHO", each "REFERENCIAL: no participa en la prioridad hasta superar el baseline", type text),
				    SinAuxiliares = Table.RemoveColumns(ConUsoDias, {"_LISTA_CRITERIOS", "PROB_ML_ATRASO", "ES_FIN_MES", "ES_PENDIENTE"}),
				    Ordenado = Table.Sort(SinAuxiliares, {{"ORDEN_PRIORIDAD", Order.Ascending}, {"PRIORIDAD_OPERATIVA_SCORE", Order.Descending}, {"DIAS_ACTUALES_DH", Order.Descending}, {"VALOR_NETO", Order.Descending}}),
				    ConRank = Table.AddIndexColumn(Ordenado, "RANK_PRIORIDAD", 1, 1, Int64.Type),
