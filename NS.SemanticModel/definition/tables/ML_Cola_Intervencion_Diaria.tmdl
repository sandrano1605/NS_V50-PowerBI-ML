	column USO_DH_PREDICHO
		dataType: string
		lineageTag: 0ae179f3-55f5-43ba-93c3-2d28234f7488
		summarizeBy: none
		sourceColumn: USO_DH_PREDICHO

	partition ML_Cola_Intervencion_Diaria = m
		mode: import
		source =
				let
				    Base = ML_Pedidos_Pendientes_Intervencion,
				    ConRankDiario = Table.AddColumn(Base, "RANK_DIARIO", each [RANK_INTERVENCION], Int64.Type),
				    ConTramo = Table.AddColumn(ConRankDiario, "TRAMO_DIARIO", each
				        if [RANK_DIARIO] <= 5 then "TOP 5"
				        else if [RANK_DIARIO] <= 10 then "TOP 10"
				        else if [RANK_DIARIO] <= 20 then "TOP 20"
				        else "RESTO", type text),
				    ConNivel = Table.AddColumn(ConTramo, "NIVEL_COLA", each
				        if [RANK_DIARIO] <= 5 then "P1 · INTERVENIR"
				        else if [RANK_DIARIO] <= 10 then "P2 · REVISAR"
				        else if [RANK_DIARIO] <= 20 then "P3 · PLAN 24H"
				        else "P4 · MONITOREAR", type text),
				    ConPlazo = Table.AddColumn(ConNivel, "PLAZO_ACCION", each
				        if [RANK_DIARIO] <= 5 then "HOY · INMEDIATO"
				        else if [RANK_DIARIO] <= 10 then "HOY"
				        else if [RANK_DIARIO] <= 20 then "PRÓXIMAS 24 HORAS"
				        else "SEGUIMIENTO", type text),
				    ConPrioridadAbsoluta = Table.AddColumn(ConPlazo, "PRIORIDAD_ABSOLUTA", each [PRIORIDAD_INTERVENCION], type text),
				    ConAccion = Table.AddColumn(ConPrioridadAbsoluta, "ACCION_DIARIA", each
				        let foco = if [FOCO_INTERVENCION] = null or Text.Trim([FOCO_INTERVENCION]) = "" then "área responsable" else [FOCO_INTERVENCION]
				        in
				            if [RANK_DIARIO] <= 5 then "Escalar ahora a " & foco & "; confirmar causa, responsable y hora de liberación"
				            else if [RANK_DIARIO] <= 10 then "Revisar hoy con " & foco & "; registrar compromiso y próxima actualización"
				            else if [RANK_DIARIO] <= 20 then "Definir plan de salida dentro de 24 horas con " & foco
				            else "Monitorear avance y mantener responsable visible", type text),
				    Seleccion = Table.SelectColumns(ConAccion, {
				        "RANK_DIARIO", "TRAMO_DIARIO", "NIVEL_COLA", "PLAZO_ACCION", "PRIORIDAD_ABSOLUTA",
				        "SCORE_INTERVENCION", "ESTADO_SLA_OPERATIVO", "SEVERIDAD_SLA", "EXCESO_SLA_DH",
				        "MOTIVO_PRINCIPAL_INTERVENCION", "ACCION_DIARIA", "PED_NUMERO_PEDIDO", "PED_FECHA",
				        "CLIENTE", "VENDEDOR", "PED_CANAL", "PED_REGION", "VALOR_NETO", "HITO_ACTUAL",
				        "FOCO_INTERVENCION", "DIAS_ACTUALES_DH", "DIAS_EN_ESTADO_DH", "PROB_ML_ATRASO_NORM",
				        "RIESGO_HISTORICO_MAX", "HIST_SOPORTE_MIN", "CRITERIOS_ACTIVOS", "PUNTOS_EXCESO_SLA",
				        "PUNTOS_RIESGO_ML", "PUNTOS_PERMANENCIA", "PUNTOS_VALOR", "PUNTOS_HISTORICO",
				        "PUNTOS_FIN_MES", "USO_DH_PREDICHO"
				    }),
				    Ordenado = Table.Sort(Seleccion, {{"RANK_DIARIO", Order.Ascending}})
				in
				    Ordenado

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table
