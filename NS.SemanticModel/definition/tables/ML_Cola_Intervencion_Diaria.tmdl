/// Cola diaria relativa. Garantiza un orden operativo Top 5 / siguientes 5 / plan 24 h / monitoreo.
table ML_Cola_Intervencion_Diaria
	lineageTag: 024d045d-7822-418e-9cdd-55074967ca63

	measure 'Cola Diaria Total' = COUNTROWS(ML_Cola_Intervencion_Diaria)
		formatString: #,0
		displayFolder: 05. Cola Diaria\Volumen
		lineageTag: 04c8a858-a74f-4720-b308-a8c673005636

	measure 'Cola Intervenir Hoy' = CALCULATE(COUNTROWS(ML_Cola_Intervencion_Diaria), ML_Cola_Intervencion_Diaria[NIVEL_COLA] = "P1 · INTERVENIR")
		formatString: #,0
		displayFolder: 05. Cola Diaria\Prioridad
		lineageTag: 74e57483-b65f-4fb9-a591-d0dacb479d39

	measure 'Cola Revisar Hoy' = CALCULATE(COUNTROWS(ML_Cola_Intervencion_Diaria), ML_Cola_Intervencion_Diaria[NIVEL_COLA] = "P2 · REVISAR")
		formatString: #,0
		displayFolder: 05. Cola Diaria\Prioridad
		lineageTag: 66f40db5-b357-4dc7-acf8-4ecf1d690992

	measure 'Cola Plan 24H' = CALCULATE(COUNTROWS(ML_Cola_Intervencion_Diaria), ML_Cola_Intervencion_Diaria[NIVEL_COLA] = "P3 · PLAN 24H")
		formatString: #,0
		displayFolder: 05. Cola Diaria\Prioridad
		lineageTag: 16636605-b358-4cb7-86c5-0e86548777ae

	measure 'Cola Monitorear' = CALCULATE(COUNTROWS(ML_Cola_Intervencion_Diaria), ML_Cola_Intervencion_Diaria[NIVEL_COLA] = "P4 · MONITOREAR")
		formatString: #,0
		displayFolder: 05. Cola Diaria\Prioridad
		lineageTag: 82c928bc-9694-48ad-83a2-0b2ff4176325

	measure 'Valor Top 10' = CALCULATE(SUM(ML_Cola_Intervencion_Diaria[VALOR_NETO]), ML_Cola_Intervencion_Diaria[TRAMO_DIARIO] IN {"TOP 5", "TOP 10"})
		formatString: "CLP $" #,0;-"CLP $" #,0;"CLP $" 0
		displayFolder: 05. Cola Diaria\Impacto
		lineageTag: 43ee3f65-da87-4b48-88d2-3b346d42485a

