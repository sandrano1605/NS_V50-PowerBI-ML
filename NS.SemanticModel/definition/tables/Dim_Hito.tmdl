				                        {"DH_PRIMER_PACKING_A_PRIMERA_FACTURA", "NORMAL", "Operación interna", 50, "Packing → Factura", "Tiempo desde el primer packing hasta la primera factura.", "Días hábiles"},
				                        {"DH_PRIMER_PICKING_A_PRIMERA_FACTURA", "NORMAL", "Operación interna", 60, "Picking → Factura", "Tiempo desde el primer picking hasta la primera factura.", "Días hábiles"},
				                        {"DH_OPERACION_INTERNA", "NORMAL", "Operación interna", 70, "Crédito → Factura", "Tiempo operacional completo desde crédito hasta primera factura.", "Días hábiles"},
				                        {"DH_DESPACHO", "NORMAL", "Despacho", 80, "Factura → Despacho", "Tiempo desde la primera factura hasta el primer despacho.", "Días hábiles"},
				                        {"DH_LEAD_NORMAL", "NORMAL", "Lead total", 90, "Pedido → Despacho (Lead)", "Lead principal del flujo normal desde creación hasta primer despacho.", "Días hábiles"},
				                        {"DH_DESPACHO_A_CEDIBLE", "NORMAL", "Cedible", 100, "Despacho → Cedible", "Tiempo desde el primer despacho hasta el primer documento cedible.", "Días hábiles"},
				                        {"DH_CREACION_A_CEDIBLE", "NORMAL", "Cedible", 110, "Pedido → Cedible", "Tiempo desde la creación del pedido hasta el primer documento cedible.", "Días hábiles"},
				                        {"DH_FES_CREDITO_A_PRIMER_DESPACHO", "FES", "FES", 201, "Crédito → Primer despacho", "Tiempo FES desde crédito hasta primer despacho.", "Días hábiles"},
				                        {"DH_FES_FACTURA_A_PRIMER_DESPACHO", "FES", "FES", 202, "Factura → Primer despacho", "Tiempo FES desde factura original hasta primer despacho.", "Días hábiles"},
				                        {"DH_FES_FACTURA_A_PRIMER_PEDIDO_POSTERIOR", "FES", "FES", 203, "Factura → Pedido posterior", "Tiempo desde factura original hasta primer pedido posterior.", "Días hábiles"},
				                        {"DH_FES_PRIMER_PEDIDO_A_PRIMERA_ENTREGA_POSTERIOR", "FES", "FES", 204, "Pedido posterior → Entrega posterior", "Tiempo desde primer pedido posterior hasta primera entrega posterior.", "Días hábiles"},
				                        {"DH_FES_PRIMERA_ENTREGA_A_PRIMER_MANIFIESTO", "FES", "FES", 205, "Entrega posterior → Primer manifiesto", "Tiempo desde primera entrega posterior hasta primer manifiesto.", "Días hábiles"},
				                        {"DH_FES_FACTURA_A_PRIMER_MANIFIESTO", "FES", "FES", 206, "Factura → Primer manifiesto", "Tiempo desde factura original hasta la primera salida operacional real.", "Días hábiles"},
				                        {"DH_FES_FACTURA_A_ULTIMO_MANIFIESTO", "FES", "FES", 207, "Factura → Último manifiesto", "Tiempo desde factura original hasta cierre operacional FES completo.", "Días hábiles"},
				                        {"DH_FES_BRECHA_PRIMER_ULTIMO_MANIFIESTO", "FES", "FES", 208, "Primer → Último manifiesto", "Brecha entre primera y última salida operacional FES.", "Días hábiles"},
				                        {"DH_ENTREGA_COMPLETA_100", "SALDO", "Saldo", 301, "Pedido → Entrega completa 100%", "Tiempo desde creación del pedido hasta el último despacho.", "Días hábiles"},
				                        {"DH_BRECHA_PRIMER_ULTIMO_DESPACHO", "SALDO", "Saldo", 302, "Primer → Último despacho", "Brecha entre el primer y el último despacho.", "Días hábiles"},
				                        {"DH_PRIMERA_FACTURA_A_ULTIMO_DESPACHO", "SALDO", "Saldo", 303, "Primera factura → Último despacho", "Tiempo desde primera factura hasta cierre del despacho.", "Días hábiles"},
				                        {"DH_ENT_PRIMERA_ULTIMA", "SALDO", "Saldo", 304, "Primera → Última entrega", "Brecha entre primera y última entrega.", "Días hábiles"},
				                        {"DH_PIC_PRIMERO_ULTIMO", "SALDO", "Saldo", 305, "Primer → Último picking", "Brecha entre primer y último picking.", "Días hábiles"},
				                        {"DH_PAC_PRIMERO_ULTIMO", "SALDO", "Saldo", 306, "Primer → Último packing", "Brecha entre primer y último packing.", "Días hábiles"},
