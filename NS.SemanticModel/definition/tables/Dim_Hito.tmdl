				                        {"DH_CREDITO_COBRANZAS", "NORMAL", "Crédito", 10, "Pedido → Crédito", "Tiempo desde la creación del pedido hasta la liberación o gestión de crédito.", "Días hábiles"},
				                        {"DH_CREDITO_A_PRIMERA_ENTREGA", "NORMAL", "Operación interna", 20, "Crédito → Entrega", "Tiempo desde crédito hasta la primera entrega creada.", "Días hábiles"},
				                        {"DH_PRIMERA_ENTREGA_A_PRIMER_PICKING", "NORMAL", "Operación interna", 30, "Entrega → Picking", "Tiempo desde la primera entrega hasta el primer picking.", "Días hábiles"},
