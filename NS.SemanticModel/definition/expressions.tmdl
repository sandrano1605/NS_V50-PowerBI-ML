expression Dim_Entrega_Normal_FES =
		let
		    // 1. Origen: consulta a SQL
		    Origen = Sql.Database("128.1.3.21", "DMF_VTA_PRD", [Query=" SELECT VGBEL,VGPOS,LIPS_SAP.MATNR,LIPS_SAP.POSNR,BWART,LIPS_SAP.VBELN,LFIMG,WADAT_IST,LIKP_SAP.ERDAT#(lf)#(lf)              FROM LIKP_SAP#(lf)              INNER JOIN LIPS_SAP #(lf)                  ON LIKP_SAP.VBELN = LIPS_SAP.VBELN#(lf)              WHERE #(lf)                  LIKP_SAP.ERDAT > GETDATE()-120"]),
		
		    // 3. Cambiar tipo de VGBEL a entero
		    #"Tipo cambiado" = Table.TransformColumnTypes(
		        Origen,
		        {{"VGBEL", Int64.Type}}
		    ),
		
		    // 5. Cambiar tipo de VGBEL a texto y WADAT_IST a fecha
		    #"Tipo cambiado1" = Table.TransformColumnTypes(
		        #"Tipo cambiado",
		        {{"VGBEL", type text}, {"WADAT_IST", type date}}
		    ),
		    // 6. Reemplazar errores en WADAT_IST por null
		    #"Errores reemplazados" = Table.ReplaceErrorValues(
		        #"Tipo cambiado1",
		        {{"WADAT_IST", null}}
		    ),
		
		    // 8. Filtrar BWART <> '911'
		    #"Filas filtradas" = Table.SelectRows(#"Errores reemplazados", each [BWART] = "911"),
		
		    // 9. Crear columna fecha_real: si hay WADAT_IST usarla, si no usar ERDAT
		    #"Columna fecha_real agregada" = Table.AddColumn(
		        #"Filas filtradas",
		        "fecha_real",
		        each if [WADAT_IST] <> null then [WADAT_IST] else [ERDAT],
		        type date
		    ),
		
		    // 10. Tabla agrupada por VGBEL para obtener la primera fecha de entrega
		    //     (mínimo de fecha_real por pedido)
		    #"TablaMinFechas" = Table.Group(
		        #"Columna fecha_real agregada",
		        {"VGBEL"},
		        {
		            {"fecha primera entrega", each List.Min([fecha_real]), type date}
		        }
		    ),
		
		    // 11. Hacer join para traer la fecha primera entrega a cada fila
		    #"Unidas tablas" = Table.NestedJoin(
		        #"Columna fecha_real agregada",
		        {"VGBEL"},
		        #"TablaMinFechas",
		        {"VGBEL"},
		        "tMin",
		        JoinKind.LeftOuter
		    ),
		
		    // 12. Expandir la columna anidada con la fecha primera entrega
		    #"Columna fecha_primera_entrega expandida" = Table.ExpandTableColumn(
		        #"Unidas tablas",
		        "tMin",
		        {"fecha primera entrega"},
		        {"fecha primera entrega"}
		    ),
		    #"Filas agrupadas" = Table.Group(#"Columna fecha_primera_entrega expandida", {"VGBEL", "VGPOS", "BWART"}, {{"VBELN", each List.Min([VBELN]), type nullable number}, {"POANR", each List.Min([POSNR]), type nullable text}, {"LFIMG", each List.Min([VGBEL]), type nullable text}, {"WADAT_IST", each List.Min([WADAT_IST]), type nullable date}, {"ERDAT", each List.Min([ERDAT]), type text}, {"fecha primera entrega", each List.Min([fecha primera entrega]), type nullable date}}),
		    #"Filas agrupadas1" = Table.Group(#"Filas agrupadas", {"VGBEL", "VBELN"}, {{"Recuento", each Table.RowCount(_), Int64.Type}, {"fecha_contabiliza", each List.Min([WADAT_IST]), type nullable date}, {"fecha_creacion", each List.Min([ERDAT]), type text}}),
		    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Filas agrupadas1",{{"VBELN", type text}}),
		    #"Columnas reordenadas" = Table.ReorderColumns(#"Tipo cambiado2",{"VBELN", "VGBEL", "Recuento", "fecha_contabiliza", "fecha_creacion"})
		in
		    #"Columnas reordenadas"
	lineageTag: 3ae156f0-2b81-4abd-aee8-623ac417d9ee
