expression Dim_WMS_Manifiesto_NORMAL =
		let
		    Origen =
		        Sql.Database("128.1.3.60", "PASO_WMS", [Query="SET NOCOUNT ON;#(lf)#(lf)SELECT#(lf)    CONVERT(BIGINT, MAD_PEDIDO)  AS PEDIDO_WMS,#(lf)    CONVERT(BIGINT, MAD_ENTREGA) AS ENTREGA_WMS,#(lf)    CONVERT(BIGINT, MAD_NRO_SAP) AS NRO_SAP_WMS,#(lf)    MIN(MAD_FECHA_EMISION) AS MANIFIESTO_WMS_MIN,#(lf)    MAX(MAD_FECHA_EMISION) AS MANIFIESTO_WMS_MAX,#(lf)    COUNT(*) AS CANTIDAD_DETALLE#(lf)FROM dbo.MANIFIESTO_D#(lf)GROUP BY CONVERT(BIGINT, MAD_PEDIDO), CONVERT(BIGINT, MAD_ENTREGA), CONVERT(BIGINT, MAD_NRO_SAP);"]),
		    Tipos =
		        Table.TransformColumnTypes(
		            Origen,
		            {
		                {"PEDIDO_WMS", type text},
		                {"ENTREGA_WMS", Int64.Type},
		                {"NRO_SAP_WMS", Int64.Type},
		                {"MANIFIESTO_WMS_MIN", type datetime},
		                {"MANIFIESTO_WMS_MAX", type datetime},
		                {"CANTIDAD_DETALLE", Int64.Type}
		            }
		        ),
		    Limpios =
		        Table.TransformColumns(
		            Tipos,
		            {
		                {"PEDIDO_WMS", each if _ = null then null else Text.Trim(_), type nullable text},
		                {"ENTREGA_WMS", each if _ = null then null else _, type nullable number},
		                {"NRO_SAP_WMS", each if _ = null then null else _, type nullable number},
		                {"MANIFIESTO_WMS_MIN", each if _ = null then null else _, type nullable datetime},
		                {"MANIFIESTO_WMS_MAX", each if _ = null then null else _, type nullable datetime},
		                {"CANTIDAD_DETALLE", each if _ = null then null else _, type nullable number}
		            }
		        ),
		    Filtrados = Table.SelectRows(Limpios, each [CANTIDAD_DETALLE] <> null),
		    Unicos = Table.Distinct(Filtrados, {"PEDIDO_WMS", "ENTREGA_WMS", "NRO_SAP_WMS"}),
		    #"Tipo cambiado" = Table.TransformColumnTypes(Unicos,{{"ENTREGA_WMS", type text}, {"PEDIDO_WMS", type text}}),
		    #"Filas agrupadas" = Table.Group(#"Tipo cambiado", {"ENTREGA_WMS"}, {{"Recuento", each List.Min([MANIFIESTO_WMS_MIN]), type nullable datetime}}),
		    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Filas agrupadas",{{"Recuento", "Fecha_mani_manual"}}),
		    #"Filas filtradas" = Table.SelectRows(#"Columnas con nombre cambiado", each ([ENTREGA_WMS] <> null and [ENTREGA_WMS] <> "0"))
		in
		    #"Filas filtradas"
